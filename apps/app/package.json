{
  "name": "@ssm-usor/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --port 5173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "generate:routes": "tsr generate",
    "test:e2e": "playwright test",
    "test:e2e:flows": "playwright test --config playwright.flows.config.ts",
    "preview": "vite preview --port 4173",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@docx-editor.dev/core": "catalog:",
    "@docx-editor.dev/fonts": "catalog:",
    "@docx-editor.dev/react": "catalog:",
    "@hookform/resolvers": "^5.9.2",
    "@ssm-usor/api-http": "workspace:*",
    "@ssm-usor/contracts": "workspace:*",
    "@ssm-usor/document-engine": "workspace:*",
    "@ssm-usor/help-topics": "workspace:*",
    "@ssm-usor/ui": "workspace:*",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "10.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "fflate": "^0.8.3",
    "libphonenumber-js": "catalog:",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "posthog-js": "1.433.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-joyride": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@posthog/rollup-plugin": "1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "5.104.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.46",
