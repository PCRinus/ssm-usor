{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ssm-usor-app",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "app.ssmusor.ro",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "non-prod": {
      "routes": [
        {
          "pattern": "app.non-prod.ssmusor.ro",
          "custom_domain": true,
        },
      ],
    },
  },
}
