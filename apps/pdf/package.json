{
  "name": "@ssm-usor/pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "wrangler dev --port 8791 --inspector-port 9240",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:signer": "python3 -m venv signer/.venv && signer/.venv/bin/pip install --require-hashes --requirement signer/requirements-dev.txt",
    "test:signer": "cd signer && .venv/bin/python -m pytest",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@ssm-usor/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
