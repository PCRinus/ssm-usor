{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ssm-usor-pdf",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  // Internal only: the API reaches it through a service binding.
  "workers_dev": false,
  "preview_urls": false,
  // Gotenberg in a Cloudflare Container (ADR 005). One instance is plenty: issuing a document
  // is rare, and a second request waits its turn inside Gotenberg. LibreOffice wants more
  // than the 1 GiB of `basic`.
  "containers": [
    {
      "class_name": "Gotenberg",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "GOTENBERG", "class_name": "Gotenberg" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gotenberg"] }],
  "observability": {
    "enabled": true,
  },
}
