{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ssm-usor-pdf",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  // Internal only: the API reaches it through a service binding.
  "workers_dev": false,
  "preview_urls": false,
  // Gotenberg in a Cloudflare Container (ADR 005). One instance is plenty: issuing a document
  // is rare, and a second request waits its turn inside Gotenberg. LibreOffice wants more
  // than the 1 GiB of `basic`.
  "containers": [
    {
      "class_name": "Gotenberg",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1,
    },
    // pyHanko for the signatures (ADR 023). One instance, because a signature's second phase must
    // reach the session its first phase left in memory. `lite` takes some forty seconds to start
    // the service on its sixteenth of a CPU; `basic` takes about four.
    {
      "class_name": "Signer",
      "image": "./signer/Dockerfile",
      "instance_type": "basic",
      "max_instances": 1,
    },
    // LibreOffice, poppler and ImageMagick for the imports (ADR 030), LibreOffice sized as for
    // Gotenberg. Two instances, as `extractorInstances` in src/index.ts, each request sent to one
    // at random, so a slow file holds up half of the files read at once rather than all of them.
    {
      "class_name": "Extractor",
      "image": "./extractor/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 2,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GOTENBERG", "class_name": "Gotenberg" },
      { "name": "SIGNER", "class_name": "Signer" },
      { "name": "EXTRACTOR", "class_name": "Extractor" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Gotenberg"] },
    { "tag": "v2", "new_sqlite_classes": ["Signer"] },
    { "tag": "v3", "new_sqlite_classes": ["Extractor"] },
  ],
  "observability": {
    "enabled": true,
  },
  // Wrangler inherits the migrations into an environment, but not the containers or the Durable
  // Object bindings.
  "env": {
    "non-prod": {
      "containers": [
        {
          "class_name": "Gotenberg",
          "image": "./Dockerfile",
          "instance_type": "standard-1",
          "max_instances": 1,
        },
        {
          "class_name": "Signer",
          "image": "./signer/Dockerfile",
          "instance_type": "basic",
          "max_instances": 1,
        },
        {
          "class_name": "Extractor",
          "image": "./extractor/Dockerfile",
          "instance_type": "standard-1",
          "max_instances": 2,
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "GOTENBERG", "class_name": "Gotenberg" },
          { "name": "SIGNER", "class_name": "Signer" },
          { "name": "EXTRACTOR", "class_name": "Extractor" },
        ],
      },
    },
  },
}
