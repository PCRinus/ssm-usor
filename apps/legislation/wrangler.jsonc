{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ssm-usor-legislation",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  // No routes: the cron trigger is the only way in.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // 03:17 UTC: 05:17 in Bucharest in winter, 06:17 in summer.
    "crons": ["17 3 * * *"],
  },
  // Preserve SUPABASE_URL, supplied by the deployment workflow.
  "keep_vars": true,
  "observability": {
    "enabled": true,
  },
}
