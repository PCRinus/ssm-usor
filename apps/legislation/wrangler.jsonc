{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ssm-usor-legislation",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  // Only POST /run answers here, with LEGISLATION_RUN_SECRET; without that secret, nothing does.
  "routes": [{ "pattern": "legislation.ssmusor.ro", "custom_domain": true }],
  "preview_urls": false,
  "triggers": {
    // 03:17 UTC: 05:17 in Bucharest in winter, 06:17 in summer.
    "crons": ["17 3 * * *"],
  },
  // The portal refuses Cloudflare's network; the relay on Mircea's home server fetches it
  // (ADR 017). keep_vars below keeps a deployed var that leaves this list: to go direct, set
  // the portal's own address here rather than deleting the line.
  "vars": {
    "LEGISLATION_RELAY_ORIGIN": "https://legislation-relay.home-server.me",
  },
  // Preserve SUPABASE_URL, supplied by the deployment workflow.
  "keep_vars": true,
  "observability": {
    "enabled": true,
  },
}
