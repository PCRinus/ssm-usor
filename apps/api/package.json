{
  "name": "@ssm-usor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "wrangler deploy",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "e2e:server": "node --import tsx scripts/e2e-server.ts",
    "seed": "node --env-file-if-exists=.env.seed --import tsx scripts/seed.ts",
    "seed:local": "node --env-file-if-exists=.env.seed --import tsx scripts/seed.ts --local",
    "extend-trial": "node --import tsx scripts/extend-trial.ts",
    "stripe:setup": "node --import tsx scripts/stripe-setup.ts",
    "templates:register": "node --env-file-if-exists=.env.seed --import tsx scripts/register-templates.ts",
    "templates:register:local": "node --import tsx scripts/register-templates.ts --local",
    "signed-sheet:check:local": "node --import tsx scripts/check-signed-sheet.ts",
    "legislation:check": "node --env-file-if-exists=.env.seed --import tsx scripts/check-legislation.ts",
    "legislation:check:local": "node --import tsx scripts/check-legislation.ts --local",
    "signing:ca": "node --import tsx scripts/signing-ca.ts",
    "signing:check:local": "node --import tsx scripts/check-signing.ts",
    "test-sheet:check:local": "node --import tsx scripts/check-test-sheet.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@peculiar/x509": "2.1.0",
    "@scalar/hono-api-reference": "^0.12.14",
    "@ssm-usor/contracts": "workspace:*",
    "@ssm-usor/document-engine": "workspace:*",
    "@ssm-usor/legislation-check": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "reflect-metadata": "0.2.2",
    "stripe": "23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^24.19.2",
    "pizzip": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
