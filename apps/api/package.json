{
  "name": "@ssm-usor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "wrangler deploy",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "seed:admin": "node --env-file-if-exists=.env.seed --import tsx scripts/seed-admin.ts",
    "seed:admin:local": "tsx scripts/seed-admin.ts --local"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@ssm-usor/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.127.1"
  }
}
