# Development admin seed only: copy to .env.seed, which is ignored by Git.
# Worker development uses .dev.vars instead.
SUPABASE_URL=https://your-project.supabase.co
SEED_ADMIN_EMAIL=admin@ssmusor.test
SEED_ADMIN_PASSWORD=
# Optional: otherwise the script reads the hosted project's key via your logged-in Supabase CLI.
# SUPABASE_SECRET_KEY=sb_secret_your_server_key
# Optional: the seeded organization's name (defaults to SSM Ușor).
# SEED_ORGANIZATION_NAME=SSM Ușor
# Optional: the admin's name on their profile (defaults to Admin SSM Ușor).
# SEED_ADMIN_NAME=Admin SSM Ușor
