          "legalRepresentativeName": {
            "type": "string",
            "nullable": true,
            "minLength": 2,
            "maxLength": 160
          },
          "declaredEmployeeCount": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 1000000
          }
