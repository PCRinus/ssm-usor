              "birthDate",
              "birthPlace",
              "homeAddress",
              "bloodGroup",
              "rhFactor",
              "notes",
              "createdAt",
              "updatedAt",
              "archivedAt"
            ]
          }
        },
        "required": ["employee"]
      },
      "CreateEmployeeRequest": {
        "type": "object",
        "properties": {
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "cnp": {
            "type": "string",
            "nullable": true,
            "minLength": 13,
            "maxLength": 20
          },
          "employeeNumber": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 40
          },
          "email": {
            "type": "string",
            "nullable": true,
            "maxLength": 254,
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\+?[0-9][0-9 ().-]{3,18}$"
          },
          "jobTitle": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "hiredAt": {
            "type": "string",
            "format": "date"
          },
          "birthDate": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "birthPlace": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 160
          },
          "homeAddress": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 240
          },
          "bloodGroup": {
            "type": "string",
            "nullable": true,
            "enum": ["0(I)", "A(II)", "B(III)", "AB(IV)", null]
          },
          "rhFactor": {
            "type": "string",
            "nullable": true,
            "enum": ["+", "-", null]
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": ["lastName", "firstName", "jobTitle", "hiredAt"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check API availability",
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiHealth"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get the authenticated user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verified user identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "A valid user access token is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/clients": {
      "get": {
        "operationId": "listClients",
        "summary": "List the organization's active clients",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active clients ordered by legal name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientListResponse"
                }
              }
            }
          },
          "401": {
            "description": "A valid user access token is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The account is not a member of an organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createClient",
        "summary": "Create a client in the organization",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClientRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "A valid user access token is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The account is not a member of an organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "A client with this CUI already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/companies/lookup": {
      "get": {
        "operationId": "lookupCompany",
        "summary": "Look up public company data by CUI (ANAF)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 16
            },
            "required": true,
            "name": "cui",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Public registry data to prefill a client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyLookupResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid CUI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "A valid user access token is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
