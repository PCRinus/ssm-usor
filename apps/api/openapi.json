{
  "openapi": "3.0.3",
  "info": {
    "title": "SSM Ușor API",
    "version": "0.3.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiHealth": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "service": {
            "type": "string",
            "enum": ["ssm-usor-api"]
          }
        },
        "required": ["status", "service"]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "unauthorized",
              "forbidden",
              "validation_error",
              "not_found",
              "conflict",
              "service_unavailable",
              "internal_error"
            ]
          },
          "message": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"]
            }
          }
        },
        "required": ["error", "message"]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "nullable": true,
                "format": "email"
              }
            },
            "required": ["id", "email"]
          }
        },
        "required": ["user"]
      },
