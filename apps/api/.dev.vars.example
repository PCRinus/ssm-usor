# Copy to .dev.vars for local Wrangler development.
# Use the same project URL and publishable key as apps/app/.env.local (without VITE_).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# The waitlist and invitations need the settings below; without them they answer 503.
# The secret key bypasses row-level security: use the local one from `pnpm supabase:status`.
# SUPABASE_SECRET_KEY=sb_secret_your_key
# Cloudflare's test secret that accepts every token:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# API_ORIGIN=http://localhost:8787
# Where invitation links point:
# APP_ORIGIN=http://localhost:5173
# Where participant invitations point:
# PORTAL_ORIGIN=http://localhost:5174
# MARKETING_ORIGIN=http://localhost:4321
# Signs the local Supabase stack's Send Email hook; the same value is in supabase/config.toml.
# SUPABASE_AUTH_HOOK_SECRET=v1,whsec_bm90LWEtc2VjcmV0LWxvY2FsLXN0YWNrLW9ubHktMzI=
# The same for its Send SMS hook:
# SUPABASE_AUTH_SMS_HOOK_SECRET=v1,whsec_bm90LWEtc2VjcmV0LWxvY2FsLXNtcy1ob29rLW9ubHk=

# Server-only PostHog Support identity signing secret from the matching EU project.
# POSTHOG_SUPPORT_SECRET_KEY=replace_me

# Word to PDF while issuing a document. Without it, documents are issued with no PDF, and a
# contract cannot be emailed. `pnpm dev:pdf` starts the converter (Docker), `pnpm stop:pdf`
# stops it.
# GOTENBERG_URL=http://localhost:3300
# Signing PDFs (ADR 023). `pnpm dev:pdf` starts the signer beside the converter.
# SIGNER_URL=http://localhost:3301
# The signing authority (ADR 023): `pnpm --filter @ssm-usor/api signing:ca` prints all three.
# Without them, signing answers 503 signing_unavailable. Never commit the values.
# SIGNING_CA_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----"
# SIGNING_CA_CERT="-----BEGIN CERTIFICATE-----\n…\n-----END CERTIFICATE-----"
# SIGNING_KEY_ENCRYPTION_KEY=base64-of-32-random-bytes

# Billing (ADR 029). Only ever the Stripe sandbox's key here, never the live one.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# OBLIO_CLIENT_ID=account-email@example.com
# OBLIO_CLIENT_SECRET=replace_me
# Oblio has no test mode: keep proformas outside production.
# OBLIO_DOCUMENTS=proforma
