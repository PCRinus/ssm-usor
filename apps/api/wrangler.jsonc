{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ssm-usor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "routes": [{ "pattern": "api.ssmusor.ro", "custom_domain": true }],
  // Preserve public Supabase bindings supplied by the deployment workflow.
  "keep_vars": true,
  "vars": {
    "CORS_ORIGINS": "https://app.ssmusor.ro,https://portal.ssmusor.ro",
    "API_ORIGIN": "https://api.ssmusor.ro",
    "APP_ORIGIN": "https://app.ssmusor.ro",
    "PORTAL_ORIGIN": "https://portal.ssmusor.ro",
    "MARKETING_ORIGIN": "https://ssmusor.ro",
  },
  // apps/mail has no routes; this binding is the only way to reach it.
  "services": [
    { "binding": "MAIL", "service": "ssm-usor-mail", "entrypoint": "Mail" },
    // apps/sms neither: it holds the Twilio credentials and can do nothing else (ADR 022).
    { "binding": "SMS", "service": "ssm-usor-sms", "entrypoint": "Sms" },
    // apps/pdf has no routes either.
    { "binding": "PDF", "service": "ssm-usor-pdf", "entrypoint": "Pdf" },
    // The same entrypoint for its signing methods (ADR 023).
    { "binding": "SIGNER", "service": "ssm-usor-pdf", "entrypoint": "Pdf" },
  ],
  // Bulk regeneration (ADR 017): this Worker sends one message per client and consumes them.
  // `wrangler deploy` fails while the queue does not exist; the deploy workflow creates it.
  "queues": {
    "producers": [{ "binding": "REGENERATION_QUEUE", "queue": "ssm-usor-regeneration" }],
    "consumers": [
      {
        "queue": "ssm-usor-regeneration",
        // Each message merges a document and reads a dozen tables; a few per invocation, and a
        // few invocations at once, keep the database's connections for the people using the app.
        "max_batch_size": 4,
        "max_batch_timeout": 5,
        "max_concurrency": 3,
        // regeneration-queue.ts records the item as failed on the last delivery: lastDelivery
        // there is this plus one.
        "max_retries": 3,
        "retry_delay": 30,
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
  // ADR 025. Wrangler inherits none of the vars, services and queues below into an environment,
  // and an inherited route would move production's custom domain to this Worker.
  "env": {
    "non-prod": {
      "routes": [{ "pattern": "api.non-prod.ssmusor.ro", "custom_domain": true }],
      "vars": {
        "CORS_ORIGINS": "https://app.non-prod.ssmusor.ro,https://portal.non-prod.ssmusor.ro",
        "API_ORIGIN": "https://api.non-prod.ssmusor.ro",
        "APP_ORIGIN": "https://app.non-prod.ssmusor.ro",
        "PORTAL_ORIGIN": "https://portal.non-prod.ssmusor.ro",
        "MARKETING_ORIGIN": "https://non-prod.ssmusor.ro",
      },
      "services": [
        { "binding": "MAIL", "service": "ssm-usor-mail-non-prod", "entrypoint": "Mail" },
        { "binding": "SMS", "service": "ssm-usor-sms-non-prod", "entrypoint": "Sms" },
        { "binding": "PDF", "service": "ssm-usor-pdf-non-prod", "entrypoint": "Pdf" },
        { "binding": "SIGNER", "service": "ssm-usor-pdf-non-prod", "entrypoint": "Pdf" },
      ],
      "queues": {
        "producers": [
          { "binding": "REGENERATION_QUEUE", "queue": "ssm-usor-regeneration-non-prod" },
        ],
        "consumers": [
          {
            "queue": "ssm-usor-regeneration-non-prod",
            "max_batch_size": 4,
            "max_batch_timeout": 5,
            "max_concurrency": 3,
            // As in production: lastDelivery in regeneration-queue.ts is this plus one.
            "max_retries": 3,
            "retry_delay": 30,
          },
        ],
      },
    },
  },
}
