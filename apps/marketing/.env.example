# Copy to .env for local development.
# Cloudflare's test site key that always passes; pair it with the test secret in apps/api/.dev.vars.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_API_URL=http://localhost:8787
PUBLIC_APP_URL=http://localhost:5173
# Leave unset: the deployed builds get the token from CI. To try the integration locally,
# set it and open the site once with ?analytics=on.
# PUBLIC_POSTHOG_PROJECT_TOKEN=phc_replace_me
