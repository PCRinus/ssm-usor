{
  "name": "@ssm-usor/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev --port 4321",
    "stop": "astro dev stop && astro preview stop",
    "preview": "astro preview --port 4322",
    "preview:cloudflare": "pnpm build && wrangler dev --port 8788 --local-protocol https",
    "typecheck": "astro check",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@ssm-usor/design-tokens": "workspace:*",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  }
}
