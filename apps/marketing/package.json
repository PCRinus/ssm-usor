{
  "name": "@ssm-usor/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev --port 4321",
    "stop": "astro dev stop && astro preview stop",
    "preview": "astro preview --port 4322",
    "preview:cloudflare": "pnpm build && wrangler dev --port 8788 --local-protocol https",
    "typecheck": "astro check",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@ssm-usor/design-tokens": "workspace:*",
    "astro": "^7.4.2",
    "posthog-js": "1.433.0"
  },
  "devDependencies": {
    "@ssm-usor/contracts": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
