{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ssm-usor-marketing",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ssmusor.ro",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
}
