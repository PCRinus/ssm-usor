---
import BaseLayout from "../layouts/BaseLayout.astro";

const concepts = [
  {
    number: "01",
    name: "Claritate operațională",
    slug: "claritate",
    note: "Un SaaS matur, precis și energic. Produsul apare imediat în prim-plan.",
    color: "#b8f34a",
    ink: "#102b25",
  },
  {
    number: "02",
    name: "Atelier de documente",
    slug: "atelier",
    note: "Tactil, editorial și centrat pe eliminarea fluxului Word–PDF–email.",
    color: "#ed684f",
    ink: "#34251d",
  },
  {
    number: "03",
    name: "Siguranță demonstrabilă",
    slug: "siguranta",
    note: "Sobru, riguros și orientat către control, termene și trasabilitate.",
    color: "#246bfd",
    ink: "#0b1731",
  },
  {
    number: "04",
    name: "Expertul apropiat",
    slug: "aproape",
    note: "Uman, românesc și calm. Tehnologia rămâne în serviciul consultantului.",
    color: "#f0b640",
    ink: "#173b35",
  },
];
---

<BaseLayout
  title="Concepte landing page — SSM Ușor"
  description="Patru direcții vizuale pentru landing page-ul SSM Ușor."
  themeColor="#eef1e9"
>
  <main class="gallery">
    <header>
      <div>
        <p class="kicker">SSM Ușor · Explorare vizuală</p>
        <h1>Patru moduri de a spune aceeași poveste.</h1>
      </div>
      <p class="intro">
        Fiecare concept promovează aceeași promisiune: un singur loc de lucru
        pentru toți clienții unui serviciu extern SSM. Se schimbă tonul, ritmul
        și argumentul dominant.
      </p>
    </header>

    <section class="concept-grid" aria-label="Concepte vizuale">
      {
        concepts.map((concept) => (
          <a
            href={`/designs/${concept.slug}/`}
            style={`--accent:${concept.color};--ink:${concept.ink}`}
          >
            <span class="number">{concept.number}</span>
            <div class="preview" aria-hidden="true">
              <span class="preview-pill" />
              <span class="preview-title" />
              <span class="preview-title short" />
              <span class="preview-button" />
              <span class="preview-panel">
                <i />
                <i />
                <i />
              </span>
            </div>
            <div class="card-copy">
              <h2>{concept.name}</h2>
              <p>{concept.note}</p>
              <span class="open">
                Deschide conceptul <b aria-hidden="true">↗</b>
              </span>
            </div>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    color: #1c2925;
    background: #eef1e9;
    font-family: ui-sans-serif, system-ui, sans-serif;
  }

  .gallery {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    padding: 72px 0 96px;
  }

  header {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 80px;
    align-items: end;
    padding-bottom: 56px;
    border-bottom: 1px solid #c9d0c4;
  }

  .kicker {
    margin: 0 0 16px;
    color: #58665f;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(3rem, 7vw, 6.6rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .intro {
    max-width: 520px;
    margin: 0;
    color: #5f6d66;
    font-size: 1rem;
    line-height: 1.7;
  }

  .concept-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
    padding-top: 24px;
  }

  .concept-grid > a {
    position: relative;
    overflow: hidden;
    min-height: 520px;
    padding: 24px;
    border: 1px solid #ccd2c7;
    border-radius: 28px;
    color: var(--ink);
    background: #f8faf5;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .concept-grid > a:hover {
    transform: translateY(-5px);
    box-shadow: 0 28px 80px rgb(32 54 45 / 12%);
  }

  .number {
    position: absolute;
    top: 22px;
    right: 24px;
    z-index: 2;
    font-size: 0.76rem;
    font-weight: 850;
  }

  .preview {
    position: relative;
    height: 290px;
    padding: 34px;
    border-radius: 18px;
    background: var(--ink);
  }

  .preview-pill,
  .preview-title,
  .preview-button,
  .preview-panel,
  .preview-panel i {
    display: block;
  }

  .preview-pill {
    width: 72px;
    height: 9px;
    border-radius: 20px;
    background: var(--accent);
    opacity: 0.75;
  }

  .preview-title {
    width: 58%;
    height: 26px;
    margin-top: 32px;
    border-radius: 4px;
    background: #fff;
  }

  .preview-title.short {
    width: 40%;
    margin-top: 10px;
  }

  .preview-button {
    width: 100px;
    height: 32px;
    margin-top: 32px;
    border-radius: 99px;
    background: var(--accent);
  }

  .preview-panel {
    position: absolute;
    right: 28px;
    bottom: 24px;
    width: 42%;
    padding: 14px;
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 12px;
    background: rgb(255 255 255 / 10%);
  }

  .preview-panel i {
    height: 8px;
    margin: 8px 0;
    border-radius: 10px;
    background: rgb(255 255 255 / 65%);
  }

  .preview-panel i:nth-child(2) {
    width: 70%;
  }

  .preview-panel i:nth-child(3) {
    width: 84%;
  }

  .card-copy {
    padding: 26px 4px 4px;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    letter-spacing: -0.04em;
  }

  .card-copy p {
    max-width: 520px;
    min-height: 52px;
    margin: 12px 0 24px;
    color: #637068;
    line-height: 1.6;
  }

  .open {
    font-size: 0.82rem;
    font-weight: 800;
  }

  .open b {
    color: var(--accent);
    font-size: 1rem;
  }

  @media (max-width: 800px) {
    .gallery {
      width: min(100% - 24px, 1240px);
      padding-top: 40px;
    }

    header,
    .concept-grid {
      grid-template-columns: 1fr;
    }

    header {
      gap: 28px;
    }

    .concept-grid > a {
      min-height: auto;
    }
  }
</style>
