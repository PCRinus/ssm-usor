---
import {
  billing,
  calculator,
  clientsHint,
  enterprise,
  eur,
  pricingCta,
  pricingLinks,
  quote,
} from '../../components/site/pricing';
import FluxLayout from '../../layouts/FluxLayout.astro';

const employees = 250;
const members = 1;
const initial = quote(employees, members);
---

<FluxLayout title={calculator.title} description={calculator.description} current="/preturi/">
  <section class="calc" data-calculator>
    <div class="wrap">
      <header class="head">
        <a class="back" href={pricingLinks.page}>
          {calculator.back}
        </a>
        <h1>{calculator.heading}</h1>
        <p class="intro">{calculator.intro}</p>
      </header>

      <div class="panels">
        <div class="inputs">
          <div class="field">
            <div class="labelrow">
              <label for="employees">{calculator.employees}</label>
              <output for="employees" class="count" data-employees-label>
                {employees.toLocaleString('ro-RO')}
              </output>
            </div>
            <input
              id="employees"
              type="range"
              min={calculator.minEmployees}
              max={calculator.maxEmployees}
              step="10"
              value={employees}
              aria-describedby="employees-hint"
            />
            <div class="scale" id="employees-hint">
              <span>{calculator.minEmployees.toLocaleString('ro-RO')}</span>
              <span class="hint" data-clients-hint>
                {clientsHint(employees)}
              </span>
              <span>{calculator.maxEmployees.toLocaleString('ro-RO')}</span>
            </div>
          </div>

          <div class="field">
            <span class="label">{calculator.examples}</span>
            <div class="presets">
              {calculator.presets.map((preset) => (
                <button
                  type="button"
                  data-preset-employees={preset.employees}
                  data-preset-members={preset.members}
                  aria-pressed={
                    preset.employees === employees && preset.members === members ? 'true' : 'false'
                  }
                >
                  {preset.label}
                </button>
              ))}
            </div>
          </div>

          <div class="members">
            <span id="members-label" class="label">
              {calculator.members}
            </span>
            <div class="stepper" role="group" aria-labelledby="members-label">
              <button type="button" data-step="-1" aria-label={calculator.fewer}>
                −
              </button>
              <span aria-live="polite" data-members>
                {members}
              </span>
              <button type="button" data-step="1" aria-label={calculator.more}>
                +
              </button>
            </div>
          </div>
        </div>

        <div class="result">
          <span class="best">
            {calculator.best} <span data-plan>{initial.plan.name}</span>
          </span>
          <p class="total">
            <span class="amt" data-total>
              {eur(initial.total)}
            </span>
            <span class="per">{billing.perMonth}</span>
          </p>
          <ul data-lines>
            {initial.lines.map((line) => (
              <li>
                <span>{line.label}</span>
                <span class="value">{line.value}</span>
              </li>
            ))}
          </ul>
          <p class="advice" data-advice>
            {initial.advice}
          </p>
          <a
            class="cta"
            href={pricingCta.href}
            data-track="cta_clicked"
            data-track-prop-target="notify"
            data-track-prop-placement="calculator"
            data-track-prop-plan={initial.plan.id}
          >
            {pricingCta.label}
          </a>
          <span class="terms">
            {pricingCta.note} {calculator.terms}
          </span>
        </div>
      </div>

      <div class="summaries">
        {calculator.summaries.map((summary) => (
          <div class="summary">
            <strong>{summary.title}</strong>
            <span>{summary.text}</span>
          </div>
        ))}
        <div class="summary">
          <strong>{calculator.enterprise.title}</strong>
          <span>
            {calculator.enterprise.text}{' '}
            <a
              href={pricingCta.quoteHref}
              data-track="cta_clicked"
              data-track-prop-target="quote"
              data-track-prop-placement="calculator"
              data-track-prop-plan={enterprise.id}
            >
              {pricingCta.quote}
            </a>
            .
          </span>
        </div>
      </div>
    </div>
  </section>
</FluxLayout>

<script>
  import { calculator, clientsHint, eur, quote } from '../../components/site/pricing';
  import { track } from '../../lib/analytics';

  const root = document.querySelector<HTMLElement>('[data-calculator]')!;
  const range = root.querySelector<HTMLInputElement>('#employees')!;
  const presets = [...root.querySelectorAll<HTMLButtonElement>('[data-preset-employees]')];
  const cta = root.querySelector<HTMLAnchorElement>('.cta')!;
  const field = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-${name}]`)!;

  let employees = Number(range.value);
  let members = Number(field('members').textContent);
  let used = false;

  const render = () => {
    const result = quote(employees, members);
    field('employees-label').textContent = employees.toLocaleString('ro-RO');
    field('clients-hint').textContent = clientsHint(employees);
    field('members').textContent = String(members);
    field('plan').textContent = result.plan.name;
    field('total').textContent = eur(result.total);
    field('advice').textContent = result.advice;
    field('lines').replaceChildren(
      ...result.lines.map((line) => {
        const item = document.createElement('li');
        const label = document.createElement('span');
        const value = document.createElement('span');
        label.textContent = line.label;
        value.textContent = line.value;
        value.className = 'value';
        item.append(label, value);
        return item;
      })
    );
    cta.dataset.trackPropPlan = result.plan.id;
    for (const preset of presets) {
      const on =
        Number(preset.dataset.presetEmployees) === employees &&
        Number(preset.dataset.presetMembers) === members;
      preset.setAttribute('aria-pressed', String(on));
    }
  };

  const changed = (input: string) => {
    render();
    if (used) return;
    used = true;
    track('calculator_used', { input });
  };

  range.addEventListener('input', () => {
    employees = Number(range.value);
    changed('employees');
  });
  for (const preset of presets) {
    preset.addEventListener('click', () => {
      employees = Number(preset.dataset.presetEmployees);
      members = Number(preset.dataset.presetMembers);
      range.value = String(employees);
      changed('preset');
    });
  }
  for (const button of root.querySelectorAll<HTMLButtonElement>('[data-step]')) {
    button.addEventListener('click', () => {
      members = Math.min(calculator.maxMembers, Math.max(1, members + Number(button.dataset.step)));
      changed('members');
    });
  }
</script>

<style>
  .calc {
    padding: 96px 0;
    background: var(--cream);
  }
  .calc > .wrap {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 1160px;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
  }
  .back {
    align-self: flex-start;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  h1 {
    font-size: 46px;
  }
  .intro {
    color: var(--ink-2);
    font-size: 18px;
  }

  .panels {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 24px;
  }
  .inputs {
    display: flex;
    flex: 999 1 520px;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
    padding: 36px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: #fff;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .labelrow {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  label,
  .label {
    font-size: 17px;
    font-weight: 600;
  }
  .count {
    font-family: var(--display);
    font-size: 32px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--ink);
  }
  .scale {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink-2);
    font-size: 14px;
  }
  .hint {
    text-align: center;
  }
  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .presets button {
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font: 500 14px/1.2 var(--sans);
    cursor: pointer;
  }
  .presets button[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }
  .members {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .stepper button {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 9px;
    background: var(--cream);
    color: var(--ink);
    font: 600 22px/1 var(--sans);
    cursor: pointer;
  }
  .stepper span {
    min-width: 44px;
    font-size: 18px;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    text-align: center;
  }
  button:focus-visible,
  input:focus-visible,
  a:focus-visible {
    outline: 3px solid var(--lime);
    outline-offset: 2px;
  }

  .result {
    display: flex;
    flex: 1 1 380px;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    padding: 36px;
    border-radius: 20px;
    background: var(--ink);
    color: #fff;
  }
  .best {
    color: var(--lime);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .total {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
  }
  .amt {
    font-family: var(--display);
    font-size: 64px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .per,
  .advice,
  .terms {
    color: #c8d3ce;
  }
  .result ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #dbe3df;
    font-size: 15px;
  }
  .result :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #2f4d45;
  }
  .result :global(.value) {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .advice {
    font-size: 15px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: auto;
    padding: 8px 16px;
    border-radius: 10px;
    background: var(--lime);
    color: var(--ink);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }
  .cta:hover {
    background: #c6e28a;
    color: var(--ink);
  }
  .terms {
    font-size: 13px;
    text-align: center;
  }

  .summaries {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .summary {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
  }
  .summary span {
    color: var(--ink-2);
    font-size: 15px;
  }

  @media (max-width: 760px) {
    .calc {
      padding: 48px 0 72px;
    }
    h1 {
      font-size: 36px;
    }
    .intro {
      font-size: 16px;
    }
    .inputs,
    .result {
      padding: 24px 20px;
    }
    .amt {
      font-size: 56px;
    }
  }
</style>
