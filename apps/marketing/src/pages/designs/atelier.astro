---
import {
  ArrowUpRight,
  Check,
  FileCheck2,
  FilePenLine,
  Send,
  Sparkles,
} from "lucide-react";
import ConceptSwitcher from "../../components/ConceptSwitcher.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="SSM Ușor — Documentele SSM, fără drumul lung"
  description="Un atelier digital pentru documentele, datele și aprobările tuturor clienților tăi SSM."
  themeColor="#f2eadc"
>
  <div class="page">
    <ConceptSwitcher active="atelier" />
    <header class="nav frame">
      <a class="brand" href="/designs/atelier/"><b>SSM</b> Ușor</a>
      <nav aria-label="Navigație principală">
        <a href="#problema">De ce</a><a href="#atelier">Atelierul</a><a
          href="#pilot">Program pilot</a
        >
      </nav>
      <a class="small-cta" href="#pilot"
        >Vreau acces <ArrowUpRight size={15} /></a
      >
    </header>

    <main>
      <section class="hero frame">
        <div class="hero-copy">
          <p class="overline">
            <Sparkles size={14} /> În curând · construit împreună cu experți SSM
          </p>
          <h1>Documentele SSM,<br /><em>fără drumul lung.</em></h1>
          <p class="lede">
            Din datele clientului direct într-un document pregătit, trimis și
            urmărit. Fără să mai jonglezi între Word, PDF, email și foldere.
          </p>
          <div class="actions">
            <a class="primary" href="#pilot"
              >Devino partener pilot <ArrowUpRight size={18} /></a
            >
            <span>15 minute pentru o primă discuție</span>
          </div>
        </div>

        <div
          class="desk"
          aria-label="Previzualizare a atelierului de documente"
        >
          <div class="note note-one">
            Datele clientului<br /><b>completate ✓</b>
          </div>
          <div class="note note-two">
            Următorul pas<br /><b>trimite la semnat</b>
          </div>
          <div class="document">
            <div class="doc-toolbar">
              <span>IPSSM / Atelier Central</span><i></i><i></i><i></i>
            </div>
            <div class="doc-page">
              <div class="doc-kicker">INSTRUCȚIUNI PROPRII DE SECURITATE</div>
              <h2>Activitatea de prelucrare mecanică</h2>
              <p>
                Document generat din șablonul organizației și adaptat pe baza
                activităților declarate.
              </p>
              <div class="doc-field">
                <span>Unitate</span><b>Atelier Central SRL</b><Check
                  size={15}
                />
              </div>
              <div class="doc-field">
                <span>Punct de lucru</span><b>Brașov, Str. Fabricii 12</b><Check
                  size={15}
                />
              </div>
              <div class="doc-lines"><i></i><i></i><i></i><i></i></div>
              <div class="doc-footer">
                <span>Versiunea 3</span><b>Pregătit pentru revizuire</b>
              </div>
            </div>
          </div>
          <div class="stamp">DATE REUTILIZATE<br /><b>FĂRĂ COPY–PASTE</b></div>
        </div>
      </section>

      <section class="old-way" id="problema">
        <div class="frame old-grid">
          <div>
            <p class="section-label">Fluxul care consumă timpul</p>
            <h2>Șapte pași pentru ceva ce ar trebui să fie unul singur.</h2>
          </div>
          <div class="trail" aria-label="Fluxul actual de documente">
            <span>Word</span><b>→</b><span>Email</span><b>→</b><span>PDF</span
            ><b>→</b><span>Semnare</span><b>→</b><span>Folder</span>
          </div>
          <blockquote>
            „Unde este ultima versiune?” nu ar trebui să facă parte din munca
            ta.
          </blockquote>
        </div>
      </section>

      <section class="workshop frame" id="atelier">
        <div class="section-head">
          <p class="section-label">Noul tău atelier digital</p>
          <h2>Informația intră o dată.<br />Apoi lucrează pentru tine.</h2>
        </div>
        <div class="cards">
          <article>
            <span class="step">01</span><FilePenLine size={27} />
            <h3>Construiești din șabloane controlate</h3>
            <p>
              Păstrezi structura ta profesională și completezi automat datele
              deja validate ale clientului.
            </p>
            <small>DATE → DOCUMENT</small>
          </article>
          <article>
            <span class="step">02</span><Send size={27} />
            <h3>Trimiți fără exporturi intermediare</h3>
            <p>
              Clientul primește exact versiunea aprobată, iar tu vezi imediat ce
              a deschis și ce lipsește.
            </p>
            <small>DOCUMENT → CLIENT</small>
          </article>
          <article>
            <span class="step">03</span><FileCheck2 size={27} />
            <h3>Păstrezi dovada lângă muncă</h3>
            <p>
              Versiunile, aprobările și semnăturile rămân legate de client și de
              documentul corect.
            </p>
            <small>SEMNĂTURĂ → ISTORIC</small>
          </article>
        </div>
      </section>

      <section class="manifesto">
        <div class="frame">
          <span>NU ÎNLOCUIM EXPERTUL.</span>
          <h2>Îi scoatem din cale munca repetitivă.</h2>
          <p>
            Tu păstrezi judecata profesională. SSM Ușor organizează datele,
            versiunile și pașii care se repetă pentru fiecare client.
          </p>
        </div>
      </section>

      <section class="pilot frame" id="pilot">
        <div class="pilot-index">PILOT / 2026</div>
        <div>
          <p class="section-label">Pentru furnizori externi SSM</p>
          <h2>
            Arată-ne cum lucrezi astăzi. Construim împreună drumul mai scurt.
          </h2>
        </div>
        <div class="pilot-side">
          <ul>
            <li><Check size={16} /> Acces la primele fluxuri</li><li>
              <Check size={16} /> Prioritate pentru nevoile tale
            </li><li><Check size={16} /> Fără obligație de cumpărare</li>
          </ul>
          <a
            class="primary"
            href="mailto:pilot@ssmusor.ro?subject=Partener%20pilot%20SSM%20Ușor"
            >Programează o discuție <ArrowUpRight size={18} /></a
          >
        </div>
      </section>
    </main>
    <footer class="frame">
      <a class="brand" href="/"><b>SSM</b> Ușor</a><span
        >Concept 02 · Atelier de documente</span
      ><span>România · 2026</span>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(body) {
    color: #35271f;
    background: #f2eadc;
    font-family: ui-sans-serif, system-ui, sans-serif;
  }
  .page {
    overflow: hidden;
  }
  .frame {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }
  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid #d3c5b3;
  }
  .brand {
    font-family: Georgia, serif;
    font-size: 1.24rem;
    text-decoration: none;
  }
  .brand b {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.86rem;
    letter-spacing: 0.02em;
  }
  .nav nav {
    display: flex;
    gap: 28px;
  }
  .nav nav a {
    font-size: 0.74rem;
    font-weight: 750;
    text-decoration: none;
  }
  .small-cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding-bottom: 4px;
    border-bottom: 1px solid;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .hero {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
    align-items: center;
    min-height: 770px;
    padding: 70px 0 115px;
  }
  .overline {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 26px;
    color: #9b4938;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero h1 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 400;
    line-height: 0.91;
    letter-spacing: -0.06em;
  }
  .hero h1 em {
    color: #d8543d;
    font-style: italic;
  }
  .lede {
    max-width: 590px;
    margin: 28px 0 0;
    color: #78675b;
    font-family: Georgia, serif;
    font-size: 1.14rem;
    line-height: 1.72;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 34px;
  }
  .primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 2px;
    color: #fff;
    background: #35271f;
    text-decoration: none;
    font-size: 0.77rem;
    font-weight: 850;
  }
  .actions > span {
    max-width: 110px;
    color: #87766a;
    font-size: 0.62rem;
    line-height: 1.45;
  }
  .desk {
    position: relative;
    min-height: 560px;
  }
  .document {
    position: absolute;
    top: 20px;
    right: 35px;
    left: 45px;
    overflow: hidden;
    border: 1px solid #bcae9e;
    border-radius: 3px;
    background: #f9f6ef;
    box-shadow: 0 35px 70px rgb(85 57 39 / 17%);
    transform: rotate(1.5deg);
  }
  .doc-toolbar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 42px;
    padding: 0 14px;
    border-bottom: 1px solid #ddd3c6;
    color: #786b62;
    background: #ebe5dc;
    font-size: 0.54rem;
  }
  .doc-toolbar span {
    flex: 1;
  }
  .doc-toolbar i {
    width: 7px;
    height: 7px;
    border: 1px solid #94877e;
    border-radius: 50%;
  }
  .doc-page {
    margin: 20px;
    padding: 34px;
    border: 1px solid #e1d9ce;
    background: #fff;
  }
  .doc-kicker {
    color: #a55a49;
    font-size: 0.47rem;
    font-weight: 900;
    letter-spacing: 0.13em;
  }
  .doc-page h2 {
    max-width: 390px;
    margin: 14px 0;
    font-family: Georgia, serif;
    font-size: 1.8rem;
    line-height: 1.05;
  }
  .doc-page > p {
    color: #84766d;
    font-family: Georgia, serif;
    font-size: 0.7rem;
    line-height: 1.5;
  }
  .doc-field {
    display: grid;
    grid-template-columns: 85px 1fr auto;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
    padding: 10px 0;
    border-bottom: 1px solid #e7dfd5;
    font-size: 0.56rem;
  }
  .doc-field span {
    color: #93877e;
  }
  .doc-field b {
    font-weight: 750;
  }
  .doc-field svg {
    color: #4a8f6b;
  }
  .doc-lines {
    margin-top: 24px;
  }
  .doc-lines i {
    display: block;
    width: 100%;
    height: 6px;
    margin: 10px 0;
    border-radius: 4px;
    background: #ece7df;
  }
  .doc-lines i:nth-child(2) {
    width: 88%;
  }
  .doc-lines i:nth-child(4) {
    width: 61%;
  }
  .doc-footer {
    display: flex;
    justify-content: space-between;
    margin-top: 25px;
    padding-top: 14px;
    border-top: 1px solid #e7dfd5;
    color: #887b72;
    font-size: 0.5rem;
  }
  .doc-footer b {
    color: #a04d3d;
  }
  .note {
    position: absolute;
    z-index: 2;
    width: 150px;
    padding: 16px;
    box-shadow: 0 14px 35px rgb(72 49 35 / 15%);
    font-family: Georgia, serif;
    font-size: 0.65rem;
    line-height: 1.6;
    transform: rotate(-4deg);
  }
  .note b {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.56rem;
    text-transform: uppercase;
  }
  .note-one {
    top: 85px;
    left: 0;
    background: #f2cb58;
  }
  .note-two {
    right: -15px;
    bottom: 105px;
    background: #d96a51;
    transform: rotate(5deg);
    color: #fff;
  }
  .stamp {
    position: absolute;
    right: 35px;
    bottom: 8px;
    padding: 10px 17px;
    border: 2px solid #a04d3d;
    color: #a04d3d;
    font-size: 0.46rem;
    letter-spacing: 0.13em;
    text-align: center;
    transform: rotate(-5deg);
    opacity: 0.75;
  }
  .stamp b {
    font-size: 0.58rem;
  }
  .old-way {
    padding: 95px 0;
    color: #f7eee2;
    background: #382922;
  }
  .old-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 70px;
  }
  .section-label {
    color: #a65542;
    font-size: 0.66rem;
    font-weight: 880;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .old-way .section-label {
    color: #e78368;
  }
  .old-way h2 {
    max-width: 530px;
    margin: 20px 0 0;
    font-family: Georgia, serif;
    font-size: clamp(2.4rem, 4vw, 4.2rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .trail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    align-self: center;
  }
  .trail span {
    padding: 10px 14px;
    border: 1px solid #765b4e;
    border-radius: 99px;
    color: #e8d7c8;
    font-size: 0.68rem;
  }
  .trail b {
    color: #e78368;
  }
  .old-way blockquote {
    grid-column: 2;
    margin: 0;
    padding-top: 35px;
    border-top: 1px solid #6a5044;
    color: #ad968a;
    font-family: Georgia, serif;
    font-size: 1.15rem;
    font-style: italic;
  }
  .workshop {
    padding: 140px 0;
  }
  .section-head {
    display: grid;
    grid-template-columns: 0.45fr 1fr;
    gap: 50px;
  }
  .section-head .section-label {
    margin-top: 8px;
  }
  .section-head h2 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(3rem, 5.3vw, 5.6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 75px;
    background: #b9ab9b;
  }
  .cards article {
    position: relative;
    min-height: 390px;
    padding: 30px;
    background: #f2eadc;
  }
  .cards article > svg {
    margin-top: 55px;
    color: #c7523d;
  }
  .step {
    position: absolute;
    top: 30px;
    right: 30px;
    color: #9a8c80;
    font-size: 0.65rem;
    font-weight: 800;
  }
  .cards h3 {
    margin: 28px 0 16px;
    font-family: Georgia, serif;
    font-size: 1.65rem;
    font-weight: 400;
    line-height: 1.08;
  }
  .cards p {
    color: #7b6b60;
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .cards small {
    position: absolute;
    bottom: 30px;
    color: #a04d3d;
    font-size: 0.55rem;
    font-weight: 850;
    letter-spacing: 0.11em;
  }
  .manifesto {
    padding: 140px 0;
    background: #db624c;
  }
  .manifesto span {
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.15em;
  }
  .manifesto h2 {
    max-width: 990px;
    margin: 20px 0 30px;
    color: #251a15;
    font-family: Georgia, serif;
    font-size: clamp(3.5rem, 7vw, 7.5rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.065em;
  }
  .manifesto p {
    max-width: 580px;
    margin-left: auto;
    color: #4e2e26;
    font-size: 0.92rem;
    line-height: 1.75;
  }
  .pilot {
    display: grid;
    grid-template-columns: 0.22fr 1fr 0.62fr;
    gap: 55px;
    padding: 130px 0;
  }
  .pilot-index {
    font-family: Georgia, serif;
    font-size: 0.74rem;
    writing-mode: vertical-rl;
  }
  .pilot h2 {
    max-width: 680px;
    margin: 20px 0 0;
    font-family: Georgia, serif;
    font-size: clamp(2.7rem, 4.5vw, 4.7rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .pilot-side {
    align-self: end;
  }
  .pilot-side ul {
    display: grid;
    gap: 12px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }
  .pilot-side li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #75655a;
    font-size: 0.73rem;
  }
  footer {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 55px;
    align-items: center;
    padding: 35px 0;
    border-top: 1px solid #cdbfae;
    color: #8a796d;
    font-size: 0.62rem;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .desk {
      width: min(650px, 100%);
      margin: auto;
    }
    .old-grid,
    .section-head {
      grid-template-columns: 1fr;
    }
    .old-way blockquote {
      grid-column: auto;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .cards article {
      min-height: 320px;
    }
    .pilot {
      grid-template-columns: 1fr 1fr;
    }
    .pilot-index {
      display: none;
    }
    .pilot-side {
      grid-column: 2;
    }
  }
  @media (max-width: 650px) {
    .frame {
      width: min(100% - 24px, 1180px);
    }
    .nav {
      grid-template-columns: 1fr auto;
    }
    .nav nav {
      display: none;
    }
    .hero {
      padding: 60px 0 80px;
    }
    .actions {
      align-items: flex-start;
      flex-direction: column;
    }
    .desk {
      min-height: 470px;
    }
    .document {
      right: -80px;
      left: 10px;
      transform: scale(0.85) rotate(1.5deg);
      transform-origin: left top;
    }
    .note-one {
      left: -5px;
    }
    .note-two {
      right: -5px;
    }
    .old-way,
    .workshop,
    .manifesto {
      padding: 90px 0;
    }
    .pilot {
      grid-template-columns: 1fr;
    }
    .pilot-side {
      grid-column: auto;
    }
    .manifesto p {
      margin-left: 0;
    }
    footer {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
