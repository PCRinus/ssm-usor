---
import {
  ArrowRight,
  Check,
  FileClock,
  Radar,
  ScanSearch,
  ShieldCheck,
} from "lucide-react";
import ConceptSwitcher from "../../components/ConceptSwitcher.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="SSM Ușor — Conformitate pe care o poți demonstra"
  description="Control asupra termenelor, documentelor și dovezilor pentru întregul portofoliu de clienți SSM."
  themeColor="#f7f9fe"
>
  <div class="page">
    <ConceptSwitcher active="siguranta" />
    <header class="nav grid">
      <a class="brand" href="/designs/siguranta/"><span>S+</span> SSM UȘOR</a>
      <nav aria-label="Navigație principală">
        <a href="#control">Control</a><a href="#dovezi">Trasabilitate</a><a
          href="#pilot">Acces pilot</a
        >
      </nav>
      <a class="nav-cta" href="#pilot"
        >SOLICITĂ ACCES <ArrowRight size={14} /></a
      >
    </header>

    <main>
      <section class="hero grid">
        <div class="hero-copy">
          <div class="eyebrow">
            <span>●</span> SISTEM PENTRU FURNIZORI EXTERNI SSM
          </div>
          <h1>Conformitate pe care o poți <em>demonstra.</em></h1>
          <p>
            Controlezi termenele, versiunile și dovezile pentru fiecare client
            dintr-o singură vedere. Când apare o întrebare, răspunsul este deja
            organizat.
          </p>
          <div class="actions">
            <a class="primary" href="#pilot"
              >Devino partener pilot <ArrowRight size={18} /></a
            ><a class="text-link" href="#control">Explorează sistemul ↓</a>
          </div>
        </div>
        <div
          class="control-panel"
          aria-label="Panou de control al conformității"
        >
          <div class="panel-top">
            <span>PORTOFOLIU / CONTROL</span><span>31 AUG 2026 · 09:42</span>
          </div>
          <div class="score">
            <div>
              <small>SCOR PORTOFOLIU</small><strong>94<sup>%</sup></strong><span
                >↑ 6% în ultimele 30 zile</span
              >
            </div>
            <div class="radar">
              <Radar size={38} /><i></i><i></i><i></i><b>42</b><span
                >clienți monitorizați</span
              >
            </div>
          </div>
          <div class="alerts">
            <div class="alert critical">
              <b>ACȚIUNE NECESARĂ</b><strong>Instruire periodică</strong><span
                >Atelier Central · în 2 zile</span
              >
            </div>
            <div class="alert">
              <b>DE REVIZUIT</b><strong>Evaluare riscuri</strong><span
                >Nord Tehnic · în 9 zile</span
              >
            </div>
            <div class="alert done">
              <b>CONFIRMAT</b><strong>Fișe individuale</strong><span
                >Medica Verde · astăzi</span
              >
            </div>
          </div>
          <div class="audit-line">
            <span>ULTIMA ACTIVITATE</span><b
              >Documentul IPSSM-04 a fost semnat de ambele părți</b
            ><i>09:38</i>
          </div>
        </div>
      </section>

      <section class="signal">
        <div class="grid">
          <span>CONTROL MULTI-CLIENT</span><span>ISTORIC VERIFICABIL</span><span
            >TERMENE AUTOMATE</span
          ><span>VERSIUNI CLARE</span>
        </div>
      </section>

      <section class="control grid" id="control">
        <div class="section-no">01 / CONTROL</div>
        <div class="section-copy">
          <p class="label">PRIORITĂȚI VIZIBILE</p><h2>
            Nu mai descoperi problema după ce termenul a trecut.
          </h2><p>
            SSM Ușor aduce excepțiile în față. Vezi unde lipsește o acțiune,
            cine trebuie să răspundă și ce document susține fiecare decizie.
          </p>
        </div>
        <div class="control-list">
          <article>
            <FileClock size={24} /><div>
              <strong>Termene din întregul portofoliu</strong><p>
                O singură coadă de lucru, ordonată după risc și urgență.
              </p>
            </div><span>01</span>
          </article>
          <article>
            <ScanSearch size={24} /><div>
              <strong>Documentul corect, instant</strong><p>
                Cauți după client, tip, stare sau versiune, nu după numele
                folderului.
              </p>
            </div><span>02</span>
          </article>
          <article>
            <ShieldCheck size={24} /><div>
              <strong>Dovada rămâne atașată</strong><p>
                Semnarea și confirmările sunt păstrate lângă versiunea exactă.
              </p>
            </div><span>03</span>
          </article>
        </div>
      </section>

      <section class="evidence" id="dovezi">
        <div class="grid evidence-grid">
          <div class="section-no">02 / DOVEZI</div>
          <div class="timeline-card">
            <header>
              <span>JURNAL DOCUMENT</span><b>IPSSM-04 / NORD TEHNIC</b>
            </header>
            <ol>
              <li class="done">
                <i></i><span>28 AUG · 10:14</span><div>
                  <strong>Date validate</strong><p>
                    Confirmate de Andrei Pop · client
                  </p>
                </div>
              </li>
              <li class="done">
                <i></i><span>29 AUG · 14:22</span><div>
                  <strong>Versiunea 4 aprobată</strong><p>
                    Revizuită de Maria Ionescu · specialist SSM
                  </p>
                </div>
              </li>
              <li class="done">
                <i></i><span>31 AUG · 09:38</span><div>
                  <strong>Semnături complete</strong><p>
                    Document închis și arhivat
                  </p>
                </div>
              </li>
            </ol>
          </div>
          <div class="evidence-copy">
            <p class="label">TRASABILITATE NATIVĂ</p><h2>
              Istoricul nu se reconstruiește. Se creează odată cu munca.
            </h2><p>
              Fiecare acțiune importantă intră automat în jurnalul clientului.
              Ai contextul complet fără să cauți conversații și atașamente.
            </p><div class="evidence-checks">
              <span><Check size={16} /> cine</span><span
                ><Check size={16} /> ce</span
              ><span><Check size={16} /> când</span><span
                ><Check size={16} /> pe ce versiune</span
              >
            </div>
          </div>
        </div>
      </section>

      <section class="pilot grid" id="pilot">
        <div class="section-no">PILOT / DESCHIS</div>
        <div>
          <p class="label">CONSTRUIT CU UTILIZATORII REALI</p><h2>
            Vrei să vezi unde pierde timp portofoliul tău?
          </h2>
        </div>
        <div class="pilot-side">
          <p>
            Începem cu o discuție despre fluxul tău actual. Fără prezentări
            generale și fără obligații.
          </p><a
            class="primary"
            href="mailto:pilot@ssmusor.ro?subject=Partener%20pilot%20SSM%20Ușor"
            >Programează analiza <ArrowRight size={18} /></a
          >
        </div>
      </section>
    </main>
    <footer class="grid">
      <a class="brand" href="/"><span>S+</span> SSM UȘOR</a><p>
        SOFTWARE OPERAȚIONAL PENTRU SERVICII EXTERNE SSM
      </p><span>CONCEPT 03 / SIGURANȚĂ</span>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(body) {
    color: #0b1731;
    background: #f7f9fe;
    font-family: Arial, ui-sans-serif, sans-serif;
  }
  .page {
    overflow: hidden;
  }
  .grid {
    width: min(1240px, calc(100% - 48px));
    margin-inline: auto;
  }
  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 25px 0;
    border-top: 1px solid #cdd5e5;
    border-bottom: 1px solid #cdd5e5;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .brand span {
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    color: #fff;
    background: #246bfd;
    font-size: 0.7rem;
    letter-spacing: 0;
  }
  .nav nav {
    display: flex;
    gap: 32px;
  }
  .nav nav a {
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .nav-cta {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #246bfd;
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-decoration: none;
  }
  .hero {
    display: grid;
    grid-template-columns: 0.86fr 1.14fr;
    gap: 65px;
    align-items: center;
    min-height: 730px;
    padding: 78px 0 95px;
  }
  .eyebrow,
  .label {
    font-size: 0.61rem;
    font-weight: 900;
    letter-spacing: 0.13em;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #246bfd;
  }
  .eyebrow span {
    font-size: 0.5rem;
  }
  .hero h1 {
    max-width: 660px;
    margin: 27px 0 24px;
    font-size: clamp(4rem, 7vw, 7.5rem);
    line-height: 0.86;
    letter-spacing: -0.075em;
  }
  .hero h1 em {
    color: #246bfd;
    font-style: normal;
  }
  .hero-copy > p {
    max-width: 570px;
    color: #56647e;
    font-size: 1rem;
    line-height: 1.75;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-top: 34px;
  }
  .primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-height: 52px;
    padding: 0 22px;
    color: #fff;
    background: #246bfd;
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.04em;
  }
  .text-link {
    color: #4f5f7c;
    font-size: 0.68rem;
    font-weight: 850;
    text-decoration: none;
  }
  .control-panel {
    border: 1px solid #bcc7dc;
    background: #fff;
    box-shadow: 18px 18px 0 #e2e8f4;
  }
  .panel-top {
    display: flex;
    justify-content: space-between;
    padding: 14px 17px;
    border-bottom: 1px solid #d6ddea;
    color: #71809c;
    background: #f1f4fa;
    font-size: 0.48rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }
  .score {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    min-height: 175px;
  }
  .score > div {
    padding: 24px;
  }
  .score > div:first-child {
    border-right: 1px solid #d6ddea;
  }
  .score small {
    display: block;
    color: #6d7b96;
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.09em;
  }
  .score strong {
    display: block;
    margin: 9px 0 5px;
    font-size: 4rem;
    line-height: 1;
    letter-spacing: -0.08em;
  }
  .score sup {
    color: #246bfd;
    font-size: 1.3rem;
  }
  .score > div > span {
    color: #238553;
    font-size: 0.52rem;
    font-weight: 800;
  }
  .radar {
    position: relative;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .radar svg {
    position: absolute;
    right: 18px;
    top: 18px;
    color: #246bfd;
    opacity: 0.25;
  }
  .radar i {
    position: absolute;
    width: 110px;
    height: 110px;
    border: 1px solid #aebbd2;
    border-radius: 50%;
  }
  .radar i:nth-child(2) {
    width: 76px;
    height: 76px;
  }
  .radar i:nth-child(3) {
    width: 40px;
    height: 40px;
  }
  .radar b {
    z-index: 1;
    font-size: 1.6rem;
  }
  .radar span {
    z-index: 1;
    max-width: 90px;
    color: #74829b !important;
    font-size: 0.45rem !important;
  }
  .alerts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #d6ddea;
    border-bottom: 1px solid #d6ddea;
  }
  .alert {
    position: relative;
    min-height: 125px;
    padding: 19px;
    border-right: 1px solid #d6ddea;
  }
  .alert:last-child {
    border: 0;
  }
  .alert::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 3px;
    background: #efad35;
  }
  .alert.critical::before {
    background: #ef4b4b;
  }
  .alert.done::before {
    background: #31a766;
  }
  .alert b,
  .alert strong,
  .alert span {
    display: block;
  }
  .alert b {
    color: #9a6c19;
    font-size: 0.45rem;
    letter-spacing: 0.08em;
  }
  .alert.critical b {
    color: #cf3535;
  }
  .alert.done b {
    color: #21884f;
  }
  .alert strong {
    margin: 22px 0 6px;
    font-size: 0.7rem;
  }
  .alert span {
    color: #7a879e;
    font-size: 0.5rem;
  }
  .audit-line {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 15px;
    padding: 16px 18px;
    font-size: 0.48rem;
  }
  .audit-line span,
  .audit-line i {
    color: #7d899e;
    font-style: normal;
  }
  .signal {
    border-top: 1px solid #ced7e7;
    border-bottom: 1px solid #ced7e7;
  }
  .signal .grid {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding: 22px 0;
    color: #67758d;
    font-size: 0.54rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }
  .control {
    display: grid;
    grid-template-columns: 0.24fr 0.8fr 1.2fr;
    gap: 58px;
    padding: 140px 0;
  }
  .section-no {
    color: #246bfd;
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }
  .section-copy h2,
  .evidence-copy h2,
  .pilot h2 {
    margin: 20px 0 24px;
    font-size: clamp(2.8rem, 4.8vw, 5.1rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }
  .section-copy > p:last-child,
  .evidence-copy > p,
  .pilot-side > p {
    color: #64718a;
    font-size: 0.86rem;
    line-height: 1.75;
  }
  .control-list {
    border-top: 1px solid #c9d2e3;
  }
  .control-list article {
    position: relative;
    display: grid;
    grid-template-columns: 45px 1fr auto;
    gap: 14px;
    padding: 26px 0;
    border-bottom: 1px solid #c9d2e3;
  }
  .control-list svg {
    color: #246bfd;
  }
  .control-list strong {
    font-size: 0.83rem;
  }
  .control-list p {
    margin: 8px 0 0;
    color: #6d7990;
    font-size: 0.7rem;
    line-height: 1.5;
  }
  .control-list > article > span {
    color: #8a96aa;
    font-size: 0.54rem;
  }
  .evidence {
    padding: 135px 0;
    color: #eaf0fc;
    background: #0b1731;
  }
  .evidence-grid {
    display: grid;
    grid-template-columns: 0.2fr 1fr 0.85fr;
    gap: 55px;
  }
  .evidence .section-no,
  .evidence .label {
    color: #76a0ff;
  }
  .timeline-card {
    border: 1px solid #32415f;
    background: #111f3c;
  }
  .timeline-card header {
    display: grid;
    gap: 7px;
    padding: 20px;
    border-bottom: 1px solid #32415f;
  }
  .timeline-card header span {
    color: #7890b9;
    font-size: 0.48rem;
    letter-spacing: 0.1em;
  }
  .timeline-card header b {
    font-size: 0.7rem;
  }
  .timeline-card ol {
    margin: 0;
    padding: 15px 28px 28px;
    list-style: none;
  }
  .timeline-card li {
    position: relative;
    display: grid;
    grid-template-columns: 10px 92px 1fr;
    gap: 15px;
    padding: 24px 0;
    border-bottom: 1px solid #293957;
  }
  .timeline-card li:last-child {
    border: 0;
  }
  .timeline-card li i {
    width: 9px;
    height: 9px;
    margin-top: 3px;
    border: 2px solid #6d82aa;
    border-radius: 50%;
  }
  .timeline-card li.done i {
    border-color: #58d38c;
    background: #58d38c;
    box-shadow: 0 0 0 5px rgb(88 211 140 / 10%);
  }
  .timeline-card li > span {
    color: #7187af;
    font-size: 0.46rem;
  }
  .timeline-card strong {
    font-size: 0.65rem;
  }
  .timeline-card p {
    margin: 6px 0 0;
    color: #7f92b5;
    font-size: 0.5rem;
  }
  .evidence-copy {
    align-self: center;
  }
  .evidence-copy > p {
    color: #91a0bd;
  }
  .evidence-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
  }
  .evidence-checks span {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border: 1px solid #33425f;
    color: #b5c1d8;
    font-size: 0.58rem;
  }
  .evidence-checks svg {
    color: #58d38c;
  }
  .pilot {
    display: grid;
    grid-template-columns: 0.2fr 1fr 0.65fr;
    gap: 55px;
    padding: 130px 0;
  }
  .pilot .primary {
    margin-top: 25px;
  }
  footer {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: center;
    gap: 30px;
    padding: 35px 0;
    border-top: 1px solid #ccd5e4;
    color: #71809a;
    font-size: 0.53rem;
    font-weight: 850;
    letter-spacing: 0.07em;
  }
  footer p {
    text-align: center;
  }
  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .control-panel {
      width: min(720px, 100%);
    }
    .control {
      grid-template-columns: 0.18fr 1fr;
    }
    .control-list {
      grid-column: 2;
    }
    .evidence-grid {
      grid-template-columns: 0.15fr 1fr;
    }
    .evidence-copy {
      grid-column: 2;
    }
    .pilot {
      grid-template-columns: 0.15fr 1fr;
    }
    .pilot-side {
      grid-column: 2;
    }
  }
  @media (max-width: 680px) {
    .grid {
      width: min(100% - 24px, 1240px);
    }
    .nav {
      grid-template-columns: 1fr auto;
    }
    .nav nav {
      display: none;
    }
    .hero {
      padding: 60px 0 75px;
    }
    .actions {
      align-items: flex-start;
      flex-direction: column;
    }
    .control-panel {
      width: 720px;
      transform: scale(0.62);
      transform-origin: left top;
      margin-bottom: -220px;
    }
    .signal .grid {
      overflow: hidden;
      justify-content: flex-start;
    }
    .signal span {
      white-space: nowrap;
    }
    .control,
    .evidence-grid,
    .pilot {
      grid-template-columns: 1fr;
      padding: 90px 0;
    }
    .section-no {
      margin-bottom: -20px;
    }
    .control-list,
    .evidence-copy,
    .pilot-side {
      grid-column: auto;
    }
    .timeline-card {
      overflow: auto;
    }
    .evidence {
      padding: 0;
    }
    .pilot {
      gap: 35px;
    }
    footer {
      grid-template-columns: 1fr;
      gap: 13px;
    }
    footer p {
      text-align: left;
    }
  }
</style>
