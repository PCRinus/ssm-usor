---
import { notFound } from '../components/site/copy';
import FluxLayout from '../layouts/FluxLayout.astro';
---

<FluxLayout title={notFound.title} description={notFound.description} noindex>
  <section class="missing wrap" data-track-view="page_not_found">
    <div>
      <h1>{notFound.heading}</h1>
      <p class="lede">
        {notFound.before} <strong data-missing-path>{notFound.fallbackPath}</strong>{' '}
        {notFound.after}
      </p>
      <script is:inline>
        (function () {
          let path;
          try {
            path = decodeURI(location.pathname);
          } catch {
            path = location.pathname;
          }
          const target = document.querySelector('[data-missing-path]');
          if (target) target.textContent = location.host + path;
          const section = document.querySelector('[data-track-view="page_not_found"]');
          if (section) section.dataset.trackPropPath = location.pathname;
        })();
      </script>
      <ul class="pages">
        {notFound.pages.map((item) => (
          <li>
            <a href={item.href}>
              <span class="title">
                {item.title}
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
              <span class="text">{item.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="stage" aria-hidden="true">
      <div class="sheet">
        <div class="heading">
          Fișa individuală de instruire
          <br />
          privind securitatea și sănătatea în muncă
        </div>
        <div class="fields">
          <div>
            <span style="--w: 64px"></span>
            <span></span>
          </div>
          <div>
            <span style="--w: 52px"></span>
            <span></span>
          </div>
          <div>
            <span style="--w: 74px"></span>
            <span></span>
          </div>
        </div>
        <div class="table">
          {Array.from({ length: 16 }, () => (
            <span />
          ))}
        </div>
        <div class="signatures">
          <span></span>
          <span></span>
        </div>
      </div>
      <div class="stamp">
        <span class="code">404</span>
        <span class="word">negăsită</span>
      </div>
    </div>
  </section>
</FluxLayout>

<style>
  .missing {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px;
    align-items: center;
    padding: 80px 0 104px;
  }
  h1 {
    margin-bottom: 20px;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 1.05;
  }
  .lede {
    max-width: 520px;
    color: var(--ink-2);
    font-size: 1.15rem;
    line-height: 1.55;
  }
  .lede strong {
    color: var(--ink);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .pages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 36px;
  }
  /* An odd count would leave a hole in the grid; the first card takes the whole row instead. */
  .pages li:first-child:nth-last-child(odd) {
    grid-column: 1 / -1;
  }
  .pages a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 18px 20px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--ink);
    text-decoration: none;
  }
  .pages a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .pages .title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 16.5px;
    font-weight: 600;
  }
  .pages svg {
    flex: none;
  }
  .pages .text {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.5;
  }

  .stage {
    position: relative;
    height: 480px;
    overflow: hidden;
    border-radius: 18px;
    background: var(--cream);
  }
  .sheet {
    position: absolute;
    top: 44px;
    left: 50%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 300px;
    height: 392px;
    margin-left: -150px;
    padding: 26px 26px 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
    transform: rotate(-4deg);
  }
  .sheet .heading {
    color: var(--ink-2);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
  }
  .fields {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-top: 6px;
  }
  .fields div {
    display: flex;
    gap: 8px;
  }
  .fields span {
    flex: 1;
    height: 7px;
    border-radius: 4px;
    background: #edf0eb;
  }
  .fields span:first-child {
    flex: none;
    width: var(--w);
    background: #e3e8e0;
  }
  .table {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 8px;
    border: 1px solid #d4ddd5;
  }
  .table span {
    height: 30px;
    border-top: 1px solid #d4ddd5;
  }
  .table span:not(:nth-child(4n)) {
    border-right: 1px solid #d4ddd5;
  }
  .table span:nth-child(-n + 4) {
    height: 22px;
    border-top: 0;
    background: #e3e8e0;
  }
  .signatures {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
  }
  .signatures span {
    width: 90px;
    height: 1px;
    background: #ccd6ce;
  }
  .stamp {
    position: absolute;
    top: 270px;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 132px;
    height: 132px;
    margin-left: 40px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow:
      inset 0 0 0 5px var(--lime),
      inset 0 0 0 7px var(--ink);
    color: var(--ink);
    transform: rotate(12deg);
  }
  .stamp .code {
    font: 700 40px/1 var(--display);
    letter-spacing: -0.02em;
  }
  .stamp .word {
    margin-top: 4px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
  }

  @media (max-width: 960px) {
    .missing {
      display: block;
      max-width: 640px;
    }
    .stage {
      display: none;
    }
    .pages {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .missing {
      padding: 56px 0 80px;
    }
    h1 {
      margin-bottom: 16px;
    }
    .lede {
      font-size: 17px;
    }
    .pages {
      gap: 10px;
      margin-top: 32px;
    }
    .pages a {
      gap: 4px;
      padding: 16px 18px 18px;
    }
    .pages .title {
      font-size: 16px;
    }
    .pages .text {
      font-size: 14.5px;
    }
  }
</style>
