---
interface Props {
  active: "claritate" | "atelier" | "siguranta" | "aproape";
  inverted?: boolean;
}

const { active, inverted = false } = Astro.props;
const concepts = [
  { id: "claritate", label: "01 Claritate", href: "/designs/claritate/" },
  { id: "atelier", label: "02 Atelier", href: "/designs/atelier/" },
  { id: "siguranta", label: "03 Siguranță", href: "/designs/siguranta/" },
  { id: "aproape", label: "04 Aproape", href: "/designs/aproape/" },
];
---

<nav
  class:list={["concept-switcher", { inverted }]}
  aria-label="Concepte vizuale"
>
  <a class="back" href="/">Toate conceptele</a>
  <div class="concept-links">
    {
      concepts.map((concept) => (
        <a
          class:list={["concept-link", { active: concept.id === active }]}
          href={concept.href}
          aria-current={concept.id === active ? "page" : undefined}
        >
          {concept.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .concept-switcher {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
    padding: 14px 0;
    color: #24352f;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 760;
    letter-spacing: 0.02em;
  }

  .inverted {
    color: #f4f8f2;
  }

  .back,
  .concept-link {
    text-decoration: none;
  }

  .back {
    opacity: 0.7;
  }

  .back:hover,
  .concept-link:hover {
    opacity: 1;
  }

  .concept-links {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .concept-link {
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 999px;
    opacity: 0.55;
  }

  .concept-link.active {
    border-color: currentColor;
    opacity: 1;
  }

  @media (max-width: 720px) {
    .concept-switcher {
      align-items: flex-start;
      width: min(100% - 24px, 1200px);
    }

    .concept-links {
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .concept-link {
      padding: 5px 7px;
      font-size: 0.65rem;
    }
  }
</style>
