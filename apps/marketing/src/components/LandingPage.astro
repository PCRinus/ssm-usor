---
import { ArrowRight, Check, Clock3, FilePenLine, ShieldCheck } from 'lucide-react';

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductPillars from './ProductPillars.astro';
---

<BaseLayout
  title="SSM Ușor — Toți clienții tăi SSM într-un singur loc"
  description="Creezi documente, urmărești termene și colaborezi cu toți clienții tăi SSM fără Word, PDF-uri și emailuri împrăștiate."
  themeColor="#18342e"
>
  <div class="site-shell">
    <header class="nav wrap">
      <a class="brand" href="/" aria-label="SSM Ușor — Acasă">
        <img src="/brand/logo.png" alt="SSM Ușor" />
      </a>
      <nav aria-label="Navigație principală">
        <a href="#avantaje">Avantaje</a>
        <a href="#cum-functioneaza">Cum funcționează</a>
        <a href="#capabilitati">Capabilități</a>
        <a class="nav-cta" href="#pilot">Devino partener pilot</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <div class="hero-copy">
          <div class="status">
            <span></span> Platformă în dezvoltare · căutăm parteneri pilot
          </div>
          <h1>Toți clienții tăi SSM.<br /><em>Un singur loc de lucru.</em></h1>
          <p class="lede">
            Creezi și editezi documente, colectezi date, organizezi instruiri și urmărești toate
            termenele—fără să muți fișiere între Word, PDF, email și alte aplicații.
          </p>
          <div class="hero-actions">
            <a class="primary" href="#pilot">Devino partener pilot <ArrowRight size={18} /></a>
            <a class="secondary" href="#produs">Vezi cum ar funcționa</a>
          </div>
          <ul class="micro-proof" aria-label="Beneficii program pilot">
            <li><Check size={15} /> Acces prioritar</li>
            <li><Check size={15} /> Influențezi produsul</li>
            <li><Check size={15} /> Fără angajament</li>
          </ul>
        </div>

        <div class="workflow-map" id="produs" aria-label="Fluxul de lucru SSM Ușor">
          <p class="flow-label">Flux de produs · interfața finală este în dezvoltare</p>
          <div class="map-ring ring-one"></div>
          <div class="map-ring ring-two"></div>
          <div class="map-core">
            <span>UN SINGUR SISTEM</span>
            <strong>Portofoliul tău</strong>
            <small>aceleași date alimentează fiecare pas</small>
          </div>
          <div class="map-node node-data">
            <b>01</b><span><strong>Date client</strong><small>o singură sursă</small></span>
          </div>
          <div class="map-node node-docs">
            <b>02</b><span><strong>Documente</strong><small>controlate și versionate</small></span>
          </div>
          <div class="map-node node-work">
            <b>03</b><span><strong>Acțiuni</strong><small>responsabil și termen</small></span>
          </div>
          <div class="map-node node-proof">
            <b>04</b><span><strong>Dovezi</strong><small>legate de munca reală</small></span>
          </div>
          <svg viewBox="0 0 650 560" aria-hidden="true">
            <path d="M320 276C214 150 157 118 70 123"></path>
            <path d="M328 274C438 142 493 121 582 136"></path>
            <path d="M319 286C212 390 153 428 67 418"></path>
            <path d="M330 286C435 400 497 426 586 409"></path>
          </svg>
        </div>
      </section>

      <section class="proof-bar">
        <div class="wrap">
          <p>Construit special pentru <strong>servicii externe SSM</strong></p>
          <span>Multi-client</span><span>Documente versionate</span><span>Termene vizibile</span
          ><span>Istoric complet</span>
        </div>
      </section>

      <section class="advantages wrap" id="avantaje">
        <div class="section-heading">
          <p>Mai puține unelte. Mai mult control.</p>
          <h2>Munca ta nu ar trebui să fie o vânătoare de fișiere.</h2>
        </div>
        <div class="advantage-grid">
          <article class="featured">
            <span class="icon"><FilePenLine size={22} /></span>
            <p class="number">01</p>
            <h3>Documente vii, nu copii fără sfârșit.</h3>
            <p>
              Editezi din șabloane controlate, generezi versiunea finală și păstrezi istoricul fără
              denumiri precum „final_final_3.pdf”.
            </p>
            <div class="document-stack" aria-hidden="true">
              <div>
                <span>IPSSM-07</span><b>Instrucțiuni proprii</b><i>Versiunea 4 · actualizată</i>
              </div>
              <div>
                <span>FIȘĂ</span><b>Instruire periodică</b><i>Pregătită pentru semnare</i>
              </div>
            </div>
          </article>
          <article>
            <span class="icon"><Clock3 size={22} /></span>
            <p class="number">02</p>
            <h3>Știi ce urmează înainte să devină urgent.</h3>
            <p>
              Termenele, instruirile și documentele lipsă apar într-o singură listă de lucru pentru
              întregul portofoliu.
            </p>
          </article>
          <article>
            <span class="icon"><ShieldCheck size={22} /></span>
            <p class="number">03</p>
            <h3>Poți demonstra ce s-a întâmplat.</h3>
            <p>
              Fiecare trimitere, modificare, confirmare și semnătură lasă o urmă clară, ușor de
              găsit când contează.
            </p>
          </article>
        </div>
      </section>

      <section class="steps" id="cum-functioneaza">
        <div class="wrap">
          <div class="section-heading compact">
            <p>O zi de lucru mai simplă</p>
            <h2>De la cerere la document semnat, într-un singur flux.</h2>
          </div>
          <ol>
            <li>
              <span>1</span><div>
                <strong>Colectezi informația</strong><p>
                  Clientul completează exact datele de care ai nevoie.
                </p>
              </div>
            </li>
            <li>
              <span>2</span><div>
                <strong>Pregătești documentul</strong><p>
                  Lucrezi din șablon și reutilizezi datele deja validate.
                </p>
              </div>
            </li>
            <li>
              <span>3</span><div>
                <strong>Trimiți și urmărești</strong><p>
                  Semnarea, confirmările și reminderele rămân în același loc.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <ProductPillars />

      <section class="pilot wrap" id="pilot">
        <div>
          <p class="pilot-label">Program pilot · locuri limitate</p>
          <h2>
            Ajută-ne să construim instrumentul pe care ai vrea să-l deschizi în fiecare dimineață.
          </h2>
        </div>
        <div class="pilot-action">
          <p>
            Căutăm furnizori externi SSM care gestionează mai mulți clienți și vor să testeze
            primele fluxuri alături de noi.
          </p>
          <a
            class="primary light"
            href="mailto:pilot@ssmusor.ro?subject=Partener%20pilot%20SSM%20Ușor"
            >Vreau să discutăm <ArrowRight size={18} /></a
          >
        </div>
      </section>
    </main>

    <footer class="wrap">
      <a class="brand" href="/" aria-label="SSM Ușor — Acasă">
        <img src="/brand/logo.png" alt="SSM Ușor" />
      </a>
      <p>Instrumentul de lucru pentru serviciile externe SSM.</p>
      <span>Creat în România · Pentru servicii externe SSM</span>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(body) {
    color: #eef6f2;
    background: #18342e;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  .site-shell {
    overflow: hidden;
  }
  .wrap {
    width: min(1200px, calc(100% - 40px));
    margin-inline: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border-radius: 12px;
    color: #fff;
    background: #f8f7f1;
    text-decoration: none;
  }
  .brand img {
    display: block;
    width: 178px;
    height: auto;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 0.78rem;
    font-weight: 680;
  }
  .nav nav a {
    color: #d8e5e0;
    text-decoration: none;
  }
  .nav .nav-cta {
    padding: 12px 17px;
    border: 1px solid #547067;
    border-radius: 999px;
    color: #fff;
  }
  .hero {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 56px;
    align-items: center;
    min-height: 760px;
    padding: 76px 0 110px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    border: 1px solid #3e5c53;
    border-radius: 999px;
    color: #cbdad5;
    background: #21453c;
    font-size: 0.68rem;
    font-weight: 720;
  }
  .status span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #b6d86f;
    box-shadow: 0 0 0 5px rgb(182 216 111 / 11%);
  }
  h1 {
    max-width: 680px;
    margin: 28px 0 24px;
    font-size: clamp(3.65rem, 6.4vw, 6.65rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }
  h1 em {
    color: #b6d86f;
    font-style: normal;
  }
  .lede {
    max-width: 610px;
    margin: 0;
    color: #b9cbc5;
    font-size: clamp(1rem, 1.6vw, 1.23rem);
    line-height: 1.68;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 34px;
  }
  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 50px;
    padding: 0 22px;
    border-radius: 12px;
    font-size: 0.82rem;
    font-weight: 820;
    text-decoration: none;
  }
  .primary {
    color: #18342e;
    background: #b6d86f;
    box-shadow: 0 12px 40px rgb(182 216 111 / 12%);
  }
  .secondary {
    border: 1px solid #436058;
    color: #eff8f4;
  }
  .micro-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 19px;
    margin: 23px 0 0;
    padding: 0;
    color: #91aaa2;
    font-size: 0.69rem;
    list-style: none;
  }
  .micro-proof li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .workflow-map {
    position: relative;
    min-width: 620px;
    min-height: 560px;
  }
  .flow-label {
    position: absolute;
    top: 16px;
    right: 22px;
    z-index: 3;
    margin: 0;
    color: #88a098;
    font-size: 0.57rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .map-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid #436158;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .ring-one {
    width: 350px;
    height: 350px;
  }
  .ring-two {
    width: 500px;
    height: 500px;
    border-style: dashed;
    opacity: 0.55;
  }
  .map-core {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 190px;
    height: 190px;
    padding: 22px;
    border: 1px solid #58756c;
    border-radius: 50%;
    color: #19372f;
    background: #b6d86f;
    box-shadow: 0 30px 80px rgb(0 0 0 / 18%);
    text-align: center;
    transform: translate(-50%, -50%);
  }
  .map-core span {
    align-self: end;
    font-size: 0.52rem;
    font-weight: 880;
    letter-spacing: 0.11em;
  }
  .map-core strong {
    font-size: 1.3rem;
    letter-spacing: -0.04em;
  }
  .map-core small {
    align-self: start;
    max-width: 125px;
    color: #3f5e50;
    font-size: 0.57rem;
    line-height: 1.4;
  }
  .map-node {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 11px;
    width: 195px;
    padding: 13px 14px;
    border: 1px solid #4a685f;
    border-radius: 14px;
    color: #eaf1ed;
    background: #23483f;
    box-shadow: 0 18px 45px rgb(0 0 0 / 15%);
  }
  .map-node > b {
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    border-radius: 9px;
    color: #213a32;
    background: #b6d86f;
    font-size: 0.55rem;
  }
  .map-node span {
    display: grid;
    gap: 3px;
  }
  .map-node strong {
    font-size: 0.68rem;
  }
  .map-node small {
    color: #9fb4ad;
    font-size: 0.52rem;
  }
  .node-data {
    top: 76px;
    left: 12px;
  }
  .node-docs {
    top: 90px;
    right: 0;
  }
  .node-work {
    bottom: 70px;
    left: 0;
  }
  .node-proof {
    right: 4px;
    bottom: 82px;
  }
  .workflow-map svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: #6e8a80;
    stroke-dasharray: 4 6;
    stroke-width: 1.2;
  }
  .proof-bar {
    border-top: 1px solid #294a41;
    border-bottom: 1px solid #294a41;
    background: #1e4038;
  }
  .proof-bar .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    min-height: 82px;
    color: #8da69e;
    font-size: 0.7rem;
  }
  .proof-bar p {
    color: #c9d8d3;
  }
  .proof-bar strong {
    color: #b6d86f;
  }
  .proof-bar span {
    white-space: nowrap;
  }
  .advantages {
    padding: 140px 0;
    color: #142a24;
  }
  .advantages::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    z-index: -1;
    height: 1050px;
    margin-top: -140px;
    background: #edf0eb;
  }
  .section-heading {
    display: grid;
    grid-template-columns: 0.45fr 1fr;
    gap: 50px;
    align-items: start;
    margin-bottom: 60px;
  }
  .section-heading > p {
    margin: 9px 0 0;
    color: #65736d;
    font-size: 0.7rem;
    font-weight: 830;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .section-heading h2 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.9rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }
  .advantage-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 16px;
  }
  .advantage-grid article {
    position: relative;
    min-height: 400px;
    padding: 30px;
    border: 1px solid #ccd6ce;
    border-radius: 20px;
    background: #f8faf6;
  }
  .advantage-grid .featured {
    min-height: 520px;
    color: #eff7f3;
    background: #21453c;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    color: #21453c;
    background: #b6d86f;
  }
  .number {
    position: absolute;
    top: 30px;
    right: 30px;
    margin: 0;
    color: #849189;
    font-size: 0.65rem;
    font-weight: 850;
  }
  .advantage-grid h3 {
    margin: 84px 0 18px;
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  .advantage-grid article > p:last-of-type {
    color: #65736d;
    font-size: 0.87rem;
    line-height: 1.75;
  }
  .advantage-grid .featured > p:last-of-type {
    color: #adc1ba;
  }
  .document-stack {
    position: absolute;
    right: 28px;
    bottom: 28px;
    left: 28px;
    display: grid;
    gap: 8px;
  }
  .document-stack div {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 3px 14px;
    padding: 13px 15px;
    border: 1px solid #45635a;
    border-radius: 10px;
    background: #20473e;
  }
  .document-stack span {
    grid-row: span 2;
    align-self: center;
    color: #b6d86f;
    font-size: 0.52rem;
    font-weight: 850;
  }
  .document-stack b {
    font-size: 0.67rem;
  }
  .document-stack i {
    color: #85a198;
    font-size: 0.52rem;
    font-style: normal;
  }
  .steps {
    padding: 130px 0;
    color: #eef6f2;
    background: #142f29;
  }
  .section-heading.compact {
    margin-bottom: 68px;
  }
  .steps .section-heading > p {
    color: #88a39a;
  }
  .steps .section-heading h2 {
    max-width: 820px;
  }
  .steps ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: #355148;
  }
  .steps li {
    min-height: 250px;
    padding: 28px;
    background: #142f29;
  }
  .steps li > span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid #4b665e;
    border-radius: 50%;
    color: #b6d86f;
    font-size: 0.7rem;
    font-weight: 850;
  }
  .steps li div {
    margin-top: 72px;
  }
  .steps strong {
    font-size: 1.2rem;
  }
  .steps li p {
    max-width: 280px;
    color: #8da69e;
    font-size: 0.83rem;
    line-height: 1.65;
  }
  .pilot {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 100px;
    align-items: end;
    padding: 120px 0;
  }
  .pilot-label {
    color: #b6d86f;
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pilot h2 {
    max-width: 800px;
    margin: 18px 0 0;
    font-size: clamp(2.7rem, 5vw, 5rem);
    line-height: 0.97;
    letter-spacing: -0.06em;
  }
  .pilot-action p {
    color: #a9bdb6;
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .primary.light {
    margin-top: 18px;
  }
  footer {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 30px;
    align-items: center;
    padding: 40px 0;
    border-top: 1px solid #294a41;
    color: #78958c;
    font-size: 0.65rem;
  }
  footer .brand {
    font-size: 1rem;
  }
  footer p {
    text-align: center;
  }
  @media (max-width: 1050px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .workflow-map {
      min-width: 0;
      width: min(650px, 100%);
    }
    .hero-copy {
      max-width: 780px;
    }
    .advantage-grid {
      grid-template-columns: 1fr 1fr;
    }
    .advantage-grid .featured {
      grid-column: span 2;
    }
    .proof-bar span:nth-last-child(-n + 2) {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .wrap {
      width: min(100% - 24px, 1200px);
    }
    .brand img {
      width: 145px;
    }
    .nav nav > a:not(.nav-cta) {
      display: none;
    }
    .hero {
      min-height: auto;
      padding: 54px 0 80px;
    }
    .status {
      font-size: 0.6rem;
    }
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }
    .workflow-map {
      width: 620px;
      transform: scale(0.58);
      transform-origin: left top;
      margin-bottom: -220px;
    }
    .proof-bar .wrap {
      justify-content: flex-start;
      overflow: hidden;
    }
    .proof-bar span {
      display: none;
    }
    .section-heading {
      grid-template-columns: 1fr;
      gap: 15px;
    }
    .advantages {
      padding: 95px 0;
    }
    .advantages::before {
      height: 1450px;
      margin-top: -95px;
    }
    .advantage-grid {
      grid-template-columns: 1fr;
    }
    .advantage-grid .featured {
      grid-column: auto;
    }
    .steps {
      padding: 90px 0;
    }
    .steps ol {
      grid-template-columns: 1fr;
    }
    .steps li {
      min-height: 210px;
    }
    .steps li div {
      margin-top: 45px;
    }
    .pilot {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 90px 0;
    }
    footer {
      grid-template-columns: 1fr;
    }
    footer p {
      text-align: left;
    }
  }
</style>
