---
import applePay from '../../assets/payment/apple-pay-mark.svg';
import googlePay from '../../assets/payment/google-pay-mark.svg';
import CardMark from './CardMark.astro';
import { paymentFacts } from './pricing';
---

<ul class="payment" aria-label={paymentFacts.label}>
  <li>
    <CardMark class="mark" />
    <div>
      <b>{paymentFacts.payment.title}</b>
      <p class="wallets">
        <img class="apple" src={applePay.src} alt="Apple Pay" width="50" height="32" />
        <img class="google" src={googlePay.src} alt="Google Pay" width="88" height="59" />
        <span>{paymentFacts.payment.walletsText}</span>
      </p>
    </div>
  </li>
  <li>
    <svg class="mark" viewBox="0 0 68 68" aria-hidden="true">
      <circle cx="34" cy="34" r="33" fill="#eaf2d6" />
      <rect
        x="19"
        y="12"
        width="28"
        height="40"
        rx="4"
        fill="#ffffff"
        stroke="#18342e"
        stroke-width="1.6"
      />
      <path
        d="M25 21h16M25 27h16M25 33h10"
        stroke="#9fb39c"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path d="M25 42h7" stroke="#18342e" stroke-width="2" stroke-linecap="round" />
      <circle cx="48" cy="48" r="9" fill="#18342e" stroke="#eaf2d6" stroke-width="2" />
      <text
        x="48"
        y="52.5"
        text-anchor="middle"
        style="font-family: var(--display)"
        font-size="13"
        font-weight="700"
        fill="#b6d86f"
      >
        e
      </text>
    </svg>
    <div>
      <b>{paymentFacts.invoice.title}</b>
      <span>{paymentFacts.invoice.text}</span>
    </div>
  </li>
  <li>
    <svg class="mark" viewBox="0 0 68 68" aria-hidden="true">
      <circle cx="34" cy="34" r="33" fill="#eaf2d6" />
      <rect
        x="15"
        y="17"
        width="34"
        height="32"
        rx="4"
        fill="#ffffff"
        stroke="#18342e"
        stroke-width="1.6"
      />
      <path d="M15.8 25.5h32.4" stroke="#18342e" stroke-width="1.6" />
      <path d="M23 13.5v7M41 13.5v7" stroke="#18342e" stroke-width="2" stroke-linecap="round" />
      <path
        d="M21 31h4M29 31h4M37 31h4M21 38h4M29 38h4"
        stroke="#9fb39c"
        stroke-width="2.4"
        stroke-linecap="round"
      />
      <circle cx="48" cy="48" r="8" fill="#b6d86f" stroke="#ffffff" stroke-width="2" />
      <path
        d="M44.5 48l2.4 2.4 4.4-4.6"
        fill="none"
        stroke="#18342e"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <div>
      <b>{paymentFacts.cancel.title}</b>
      <span>{paymentFacts.cancel.text}</span>
    </div>
  </li>
</ul>

<style>
  .payment {
    display: grid;
    /* The first column holds both payment marks and a sentence on one line. */
    grid-template-columns: 1.3fr 1fr 1fr;
    column-gap: 32px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 22px 0;
  }
  .mark {
    display: block;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
  }
  b {
    display: block;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }
  li span {
    display: block;
    margin-top: 2px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.45;
  }
  /* Both brand guides forbid showing their mark smaller than another payment mark, so both badges
     are 32 px tall. Google's official file carries clear space around its badge; the negative
     margin takes it back, and the 12 px gap covers the clear space both guides ask for. */
  .wallets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 6px 0 0;
  }
  .wallets img {
    display: block;
    width: auto;
  }
  .apple {
    height: 32px;
  }
  .google {
    height: 59.36px;
    margin: -13.6px;
  }
  .wallets span {
    margin-top: 0;
  }
  @media (max-width: 860px) {
    .payment {
      grid-template-columns: 1fr;
    }
    li + li {
      border-top: 1px solid var(--line);
    }
  }
</style>
