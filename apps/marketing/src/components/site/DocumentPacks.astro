---
import { packs } from './copy';

const binders = [packs.ssm, packs.psi];
---

<section class="packs" id="dosare">
  <div class="wrap">
    <div class="head">
      <h2>{packs.title}</h2>
      <p>{packs.intro}</p>
    </div>
    <div class="binders">
      {binders.map((pack) => (
        <article>
          <h3>{pack.title}</h3>
          <p class="count">{pack.count}</p>
          <ol>
            {pack.sections.map((section) => (
              <li>{section}</li>
            ))}
          </ol>
        </article>
      ))}
    </div>
    <p class="note">{packs.note}</p>
  </div>
</section>

<style>
  .packs {
    padding: 88px 0;
    background: var(--cream);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 24px 64px;
    align-items: start;
    margin-bottom: 40px;
  }
  .head p {
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .binders {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }
  article {
    padding: 26px 28px 28px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
  }
  article h3 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 500;
  }
  .count {
    margin: 4px 0 18px;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  ol {
    counter-reset: section;
  }
  ol li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    padding: 9px 0;
    border-top: 1px solid var(--line);
    font-size: 0.98rem;
  }
  ol li::before {
    counter-increment: section;
    content: counter(section);
    font-family: var(--serif);
    color: var(--ink-2);
  }
  .note {
    max-width: 70ch;
    margin-top: 28px;
    color: var(--ink-2);
  }

  @media (max-width: 1080px) {
    .head {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .packs {
      padding: 56px 0;
    }
    .binders {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    article {
      padding: 20px 18px 22px;
    }
  }
</style>
