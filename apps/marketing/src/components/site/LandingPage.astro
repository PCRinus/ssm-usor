---
import FluxLayout from '../../layouts/FluxLayout.astro';
import BillingToggle from './BillingToggle.astro';
import BrowserFrame from './BrowserFrame.astro';
import {
  access,
  contract,
  cta,
  day,
  faq,
  hero,
  legislation,
  library,
  links,
  page,
  portal,
} from './copy';
import FaqAnswer from './FaqAnswer.astro';
import IPhone from './IPhone.astro';
import PaymentFacts from './PaymentFacts.astro';
import PlanCards from './PlanCards.astro';
import { pricingLinks, pricingSection } from './pricing';
import { screens } from './screens';
import StepsCarousel from './StepsCarousel.astro';
import { homeStructuredData, jsonForScript } from './structuredData';
import TrustFacts from './TrustFacts.astro';
import WaitlistForm from './WaitlistForm.astro';

const address = 'app.ssmusor.ro';
const structuredData = jsonForScript(homeStructuredData(Astro.site ?? Astro.url));
const sideShotSizes = '(max-width: 1080px) calc(100vw - 32px), 664px';
const sideShotWidths = [664, 1000, 1328, 1440];
---

<FluxLayout title={page.title} description={page.description}>
  <script slot="head" type="application/ld+json" set:html={structuredData} />
  <section class="wrap hero">
    <div>
      <h1>{hero.title}</h1>
      <p class="lede">{hero.lede}</p>
      <div class="ctas">
        <a
          class="button primary"
          href={links.login}
          data-track="cta_clicked"
          data-track-prop-target="login"
          data-track-prop-placement="hero"
        >
          {cta.login}
        </a>
        <span class="button soon" aria-disabled="true">
          {cta.signup}
          <span class="pill">{cta.signupNote}</span>
        </span>
      </div>
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        <span>
          {hero.status.before}{' '}
          <a
            href="#cont"
            data-track="cta_clicked"
            data-track-prop-target="notify"
            data-track-prop-placement="hero"
          >
            {hero.status.link}
          </a>{' '}
          {hero.status.after}
        </span>
      </p>
    </div>
    <figure class="stage" aria-label={hero.stageLabel}>
      <BrowserFrame
        src={screens.dashboard}
        alt={hero.dashboardAlt}
        address={address}
        sizes="(max-width: 760px) 620px, 880px"
        widths={[620, 880, 1240, 1440]}
        eager
      />
      <IPhone
        src={screens.phonePortalSign}
        alt={hero.phoneAlt}
        sizes="(max-width: 760px) 150px, 230px"
        eager
        address="top"
      />
    </figure>
  </section>

  <TrustFacts />

  <StepsCarousel />

  <section class="sec flush" id="preturi" data-billing-scope data-billing="monthly">
    <div class="wrap">
      <div class="pricehead">
        <div>
          <h2>{pricingSection.title}</h2>
          <p class="intro">{pricingSection.intro}</p>
        </div>
        <div class="acts">
          <a
            class="button quiet"
            href={pricingLinks.calculator}
            data-track="cta_clicked"
            data-track-prop-target="calculator"
            data-track-prop-placement="landing_pricing"
          >
            {pricingSection.calculator}
          </a>
          <a
            class="button quiet"
            href={pricingLinks.compare}
            data-track="cta_clicked"
            data-track-prop-target="compare"
            data-track-prop-placement="landing_pricing"
          >
            {pricingSection.compare}
          </a>
        </div>
      </div>
      <div class="billingrow">
        <BillingToggle placement="landing_pricing" />
      </div>
      <PlanCards placement="landing_pricing" />
      <PaymentFacts />
    </div>
  </section>

  <section class="sec flush">
    <div class="wrap dayband">
      <div>
        <h2>{day.title}</h2>
        <p class="intro">{day.intro}</p>
      </div>
      <div class="phonecol">
        <IPhone
          src={screens.phoneDashboard}
          alt={day.phoneAlt}
          host="app"
          sizes="(max-width: 760px) 220px, 270px"
        />
      </div>
    </div>
  </section>

  <section class="sec flush">
    <div class="wrap lib">
      <div>
        <h2>{library.title}</h2>
        <p class="intro">{library.intro}</p>
        <ul class="libitems">
          {library.items.map((item) => (
            <li>
              <span class="ico">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#18342e"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {item.icon === 'instructions' && (
                    <path d="M4 5a2 2 0 0 1 2-2h5v18H6a2 2 0 0 1-2-2zM20 5a2 2 0 0 0-2-2h-5v18h5a2 2 0 0 0 2-2z" />
                  )}
                  {item.icon === 'risk' && (
                    <path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z" />
                  )}
                  {item.icon === 'tests' && (
                    <>
                      <rect x="5" y="4" width="14" height="17" rx="2" />
                      <path d="M9 4V3h6v1M9 12l2 2 4-4" />
                    </>
                  )}
                </svg>
              </span>
              <div>
                <b>{item.title}</b>
                <span>{item.text}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <BrowserFrame
        src={screens.riskLibrary}
        alt={library.shotAlt}
        address={address}
        sizes={sideShotSizes}
        widths={sideShotWidths}
      />
    </div>
  </section>

  <section class="sec flush">
    <div class="wrap row">
      <BrowserFrame
        src={screens.legislation}
        alt={legislation.shotAlt}
        address={address}
        sizes={sideShotSizes}
        widths={sideShotWidths}
      />
      <div>
        <h3>{legislation.title}</h3>
        <p>{legislation.text}</p>
      </div>
    </div>
  </section>

  <section class="sec flush">
    <div class="wrap row flip">
      <ol class="note" aria-label={contract.stepsLabel}>
        {contract.steps.map((step, index) => (
          <li>
            <span class="n">{index + 1}</span>
            {step}
          </li>
        ))}
      </ol>
      <div>
        <h3>{contract.title}</h3>
        <p>{contract.text}</p>
      </div>
    </div>
  </section>

  <section class="sec portal" id="angajati">
    <div class="wrap portalgrid">
      <div>
        <h2>{portal.title}</h2>
        <p class="intro">{portal.intro}</p>
        <p class="small">{portal.note}</p>
      </div>
      <div class="phones3">
        {portal.phones.map((phone) => (
          <IPhone
            src={screens[phone.screen]}
            alt={phone.alt}
            sizes="(max-width: 760px) 31vw, 220px"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="cont">
    <div class="wrap access">
      <div>
        <h2>{access.title}</h2>
        <p class="intro">{access.intro}</p>
        <WaitlistForm />
        <p class="have-account">
          {cta.haveAccount}{' '}
          <a
            href={links.login}
            data-track="cta_clicked"
            data-track-prop-target="login"
            data-track-prop-placement="access"
          >
            {cta.login}
          </a>
        </p>
      </div>
      <ul class="facts2">
        {access.trust.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec flush" id="intrebari">
    <div class="wrap">
      <h2>{faq.title}</h2>
      <div class="faq">
        {faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>
              <FaqAnswer item={item} />
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>
</FluxLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 56px;
    align-items: center;
    padding: 72px 0 64px;
  }
  .hero h1 {
    font-size: 60px;
  }
  .lede {
    max-width: 46ch;
    margin-top: 22px;
    color: var(--ink-2);
    font-size: 19px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .status {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 44ch;
    margin-top: 22px;
    color: var(--ink-2);
    font-size: 15px;
  }
  .dot {
    flex: 0 0 8px;
    height: 8px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--lime);
  }
  .stage {
    position: relative;
    height: 560px;
    border-radius: 24px;
    background: var(--lime-soft);
    overflow: hidden;
  }
  .stage > :global(.browser) {
    position: absolute;
    top: 48px;
    left: 48px;
    width: 880px;
  }
  .stage > :global(.iphone) {
    position: absolute;
    bottom: -150px;
    left: 24px;
    width: 230px;
  }
  .hero h1,
  .lede,
  .ctas,
  .status,
  .stage {
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero h1 {
    animation-delay: 0.05s;
  }
  .lede {
    animation-delay: 0.15s;
  }
  .ctas {
    animation-delay: 0.25s;
  }
  .status {
    animation-delay: 0.35s;
  }
  .stage {
    animation-delay: 0.2s;
  }
  .stage > :global(.browser) {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.35s both;
  }
  .stage > :global(.iphone) {
    animation: rise-far 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.6s both;
  }

  .sec {
    padding: 104px 0;
  }
  .sec.flush {
    padding-top: 0;
  }
  .sec h2 {
    max-width: 22ch;
  }
  .intro {
    max-width: 58ch;
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 18px;
  }

  .pricehead {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
  }
  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .billingrow {
    margin: 32px 0 36px;
  }

  .dayband {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 48px;
    align-items: center;
    padding: 64px;
    border-radius: 28px;
    background: var(--lime-soft);
    overflow: hidden;
  }
  .phonecol {
    display: flex;
    justify-content: center;
    height: 520px;
  }
  .phonecol > :global(.iphone) {
    width: 270px;
  }

  .lib {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }
  .libitems {
    display: grid;
    gap: 22px;
    margin-top: 32px;
  }
  .libitems li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 14px;
    align-items: start;
  }
  .ico {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--lime-soft);
  }
  .libitems b {
    display: block;
    font-size: 17px;
  }
  .libitems span:not(.ico) {
    color: var(--ink-2);
    font-size: 16px;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 64px;
    align-items: center;
  }
  .row h3 {
    font-family: var(--display);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
    text-wrap: balance;
  }
  .row p {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 18px;
  }
  .row.flip > :first-child {
    order: 2;
  }
  .note {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    min-height: 280px;
    padding: 36px;
    border-radius: 24px;
    background: var(--cream);
  }
  .note li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 17px;
  }
  .note .n {
    display: inline-grid;
    place-items: center;
    flex: 0 0 32px;
    height: 32px;
    border-radius: 50%;
    background: #fff;
    font-size: 14px;
    font-weight: 600;
  }

  .portal {
    background: var(--ink);
    color: #eef6f2;
  }
  .portal h2 {
    color: #fff;
  }
  .portal .intro {
    color: #c3d1ca;
  }
  .portal .small {
    margin-top: 20px;
    color: #9fb3aa;
    font-size: 15px;
  }
  .portalgrid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: center;
  }
  .phones3 {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 24px;
  }
  .phones3 > :global(.iphone) {
    width: 220px;
  }
  .phones3 > :global(.iphone:nth-child(2)) {
    margin-top: 56px;
  }

  .access {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 64px;
    align-items: start;
  }
  .have-account {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 14px;
  }
  .facts2 {
    border-top: 1px solid var(--line);
  }
  .facts2 li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16px;
  }

  .faq {
    max-width: 860px;
    margin-top: 36px;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    color: var(--ink-2);
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    max-width: 70ch;
    padding: 0 0 22px;
    color: var(--ink-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero h1,
    .lede,
    .ctas,
    .status,
    .stage,
    .stage > :global(.browser),
    .stage > :global(.iphone) {
      animation: none;
    }
  }
  @media (max-width: 1080px) {
    .row.flip > :first-child {
      order: 0;
    }
    .hero,
    .row,
    .portalgrid,
    .dayband,
    .access,
    .lib {
      grid-template-columns: minmax(0, 1fr);
    }
    .phones3 {
      justify-content: flex-start;
    }
  }
  @media (max-width: 760px) {
    .hero {
      gap: 36px;
      padding: 40px 0;
    }
    .hero h1 {
      font-size: 40px;
    }
    .lede {
      font-size: 17px;
    }
    .ctas .button,
    .acts .button {
      flex: 1 1 100%;
    }
    .acts {
      width: 100%;
    }
    .billingrow {
      margin: 24px 0 32px;
    }
    .stage {
      height: 400px;
      border-radius: 18px;
    }
    .stage > :global(.browser) {
      top: 28px;
      left: 24px;
      width: 620px;
    }
    .stage > :global(.iphone) {
      bottom: -110px;
      left: 12px;
      width: 150px;
    }
    .sec {
      padding: 64px 0;
    }
    .intro {
      font-size: 16px;
    }
    .dayband {
      padding: 28px 20px;
      border-radius: 20px;
    }
    .phonecol {
      height: 440px;
    }
    .phonecol > :global(.iphone) {
      width: 220px;
    }
    .row h3 {
      font-size: 26px;
    }
    .phones3 {
      gap: 10px;
    }
    .phones3 > :global(.iphone) {
      width: 31%;
    }
    .phones3 > :global(.iphone:nth-child(2)) {
      margin-top: 24px;
    }
  }
</style>
