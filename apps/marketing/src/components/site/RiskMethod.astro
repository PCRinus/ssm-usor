---
import { risk } from './copy';

// Copied from `riskLevelGrid` in @ssm-usor/contracts, which the site does not depend on; keep
// the two in step.
const grid = [
  [1, 1, 1, 1, 1, 1],
  [1, 2, 2, 2, 3, 3],
  [2, 2, 3, 3, 4, 4],
  [2, 3, 4, 4, 5, 5],
  [3, 4, 4, 5, 5, 6],
  [3, 4, 5, 6, 6, 7],
  [3, 4, 5, 6, 7, 7],
];
const probabilities = [1, 2, 3, 4, 5, 6];
---

<section class="risk" id="riscuri">
  <div class="wrap risk-grid">
    <div class="copy">
      <h2>{risk.title}</h2>
      <ol>
        {risk.points.map((point, index) => (
          <li>
            <span class="n">{index + 1}</span>
            <p>{point}</p>
          </li>
        ))}
      </ol>
    </div>
    <figure data-reveal>
      <table aria-label="Grila nivelurilor de risc">
        <thead>
          <tr>
            <th scope="col">
              <span class="axis">G \ P</span>
            </th>
            {probabilities.map((p) => (
              <th scope="col">{p}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {grid.map((row, g) => (
            <tr>
              <th scope="row">{g + 1}</th>
              {row.map((level, p) => (
                <td class={`l${level}`} style={`--i:${g + p}`}>
                  {level}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      <figcaption>{risk.caption} Nivelurile de la 4 în sus sunt inacceptabile.</figcaption>
    </figure>
  </div>
</section>

<style>
  .risk {
    padding: 88px 0;
  }
  .risk-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 64px;
    align-items: center;
  }
  .copy h2 {
    margin-bottom: 28px;
  }
  .copy ol {
    display: grid;
    gap: 18px;
  }
  .copy li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 14px;
    align-items: start;
  }
  .n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--lime);
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1;
  }
  .copy p {
    color: var(--ink-2);
  }

  figure {
    margin: 0;
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 4px;
    table-layout: fixed;
    font-family: var(--serif);
    font-size: 1.05rem;
  }
  th {
    font-weight: 400;
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 0.9rem;
  }
  .axis {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }
  td {
    aspect-ratio: 1.3;
    border-radius: 6px;
    text-align: center;
    vertical-align: middle;
    color: var(--ink);
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 0.35s ease-out,
      transform 0.35s ease-out;
    transition-delay: calc(var(--i) * 45ms);
  }
  figure.is-visible td {
    opacity: 1;
    transform: none;
  }
  .l1 {
    background: color-mix(in srgb, var(--lime) 18%, #fff);
  }
  .l2 {
    background: color-mix(in srgb, var(--lime) 42%, #fff);
  }
  .l3 {
    background: color-mix(in srgb, var(--lime) 75%, #fff);
  }
  .l4 {
    background: var(--sage);
    color: #fff;
  }
  .l5 {
    background: color-mix(in srgb, var(--sage) 40%, var(--moss));
    color: #fff;
  }
  .l6 {
    background: var(--moss);
    color: #fff;
  }
  .l7 {
    background: var(--ink);
    color: #fff;
  }
  figcaption {
    padding-top: 14px;
    color: var(--ink-2);
    font-size: 0.85rem;
  }

  @media (max-width: 1080px) {
    .risk-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    figure {
      max-width: 520px;
    }
  }
  @media (max-width: 760px) {
    .risk {
      padding: 56px 0;
    }
    table {
      font-size: 0.95rem;
    }
  }
</style>
