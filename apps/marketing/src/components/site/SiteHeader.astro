---
import { Image } from 'astro:assets';

import logo from '../../assets/brand/logo.png';
import { cta, links, nav, navHref } from './copy';

interface Props {
  /** Path of the landing page, so section links work from any page. */
  home?: string;
  current?: string;
}

const { home = '/', current } = Astro.props;
---

<header class="top">
  <div class="wrap bar">
    <a class="brand" href={home} aria-label="SSM Ușor, pagina principală">
      <Image src={logo} alt="SSM Ușor" height={50} densities={[1, 2, 3]} loading="eager" />
    </a>
    <nav aria-label="Secțiuni">
      {nav.map((item) => (
        <a
          href={navHref(item.href, home)}
          aria-current={item.href === current ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="auth">
      <a
        class="button quiet"
        href={links.login}
        data-track="cta_clicked"
        data-track-prop-target="login"
        data-track-prop-placement="header"
      >
        {cta.login}
      </a>
      <span class="button soon" aria-disabled="true">
        {cta.signup}
        <span class="pill">{cta.signupNote}</span>
      </span>
    </div>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.94);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 76px;
  }
  .brand {
    flex: none;
  }
  .brand :global(img) {
    display: block;
    width: auto;
    height: 50px;
  }
  nav {
    display: flex;
    gap: 26px;
    margin-left: 12px;
    font-size: 15px;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current] {
    color: var(--ink);
    font-weight: 600;
  }
  .auth {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  @media (max-width: 1100px) {
    .auth .soon {
      display: none;
    }
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .bar {
      gap: 12px;
      height: 66px;
    }
    .brand :global(img) {
      height: 44px;
    }
  }
</style>
