---
import { Image } from 'astro:assets';

import logo from '../../assets/brand/logo.png';
import { footer, links } from './copy';

const year = new Date().getFullYear();
const commitSha = import.meta.env.PUBLIC_COMMIT_SHA ?? 'local';
const shortCommitSha = commitSha.slice(0, 7);
---

<footer class="foot">
  <div class="wrap">
    <Image src={logo} alt="SSM Ușor" height={40} densities={[1, 2, 3]} />
    <nav aria-label="Legal">
      {footer.legal.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={`mailto:${links.email}`}>{links.email}</a>
    </nav>
    <span class="copy">
      © {year} SSM Ușor
      <span
        class="version"
        title={`Commit ${commitSha}`}
        aria-label={`Versiunea site-ului: commit ${commitSha}`}
      >
        {' · '}
        <code aria-hidden="true">{shortCommitSha}</code>
      </span>
    </span>
    <p class="fine">
      Exemplele de pe site sunt ilustrative. SSM Ușor nu oferă consultanță juridică și nu
      înlocuiește responsabilitatea specialistului autorizat.
    </p>
  </div>
</footer>

<style>
  .foot {
    padding: 40px 0 56px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 14px;
  }
  .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
  }
  .wrap > :global(img) {
    display: block;
    width: auto;
    height: 40px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  nav a {
    color: var(--ink-2);
  }
  .copy {
    margin-left: auto;
  }
  .version code {
    font-size: 12px;
  }
  .fine {
    flex-basis: 100%;
    max-width: 72ch;
    margin: 0;
    font-size: 13px;
  }
  @media (max-width: 760px) {
    nav {
      gap: 0 20px;
    }
    nav a {
      padding-block: 9px;
    }
    .copy {
      margin-left: 0;
    }
  }
</style>
