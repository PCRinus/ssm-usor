---
import { links } from './copy';

const year = new Date().getFullYear();
const commitSha = import.meta.env.PUBLIC_COMMIT_SHA ?? 'local';
const shortCommitSha = commitSha.slice(0, 7);
---

<footer class="foot">
  <div class="wrap foot-grid">
    <img src="/brand/logo.png" alt="SSM Ușor" width="130" height="43" />
    <nav aria-label="Legal">
      <a href="/termeni/">Termeni și condiții</a>
      <a href="/confidentialitate/">Politica de confidențialitate</a>
      <a href={`mailto:${links.email}`}>{links.email}</a>
    </nav>
    <div class="fine">
      <p>
        Exemplele de pe site sunt ilustrative. SSM Ușor nu oferă consultanță juridică și nu
        înlocuiește responsabilitatea specialistului autorizat. {year} SSM Ușor.
      </p>
      <span
        class="version"
        title={`Commit ${commitSha}`}
        aria-label={`Versiunea site-ului: commit ${commitSha}`}
      >
        Versiune <code aria-hidden="true">{shortCommitSha}</code>
      </span>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding: 36px 0 72px;
    border-top: 1px solid var(--line);
    background: #fff;
    font-size: 0.95rem;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 160px 1fr 1fr;
    gap: 32px;
    align-items: center;
  }
  .foot-grid img {
    width: 130px;
    height: auto;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .fine {
    color: var(--ink-2);
    font-size: 0.88rem;
  }
  .version {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.78rem;
  }
  @media (max-width: 760px) {
    .foot-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    nav {
      flex-direction: column;
    }
  }
</style>
