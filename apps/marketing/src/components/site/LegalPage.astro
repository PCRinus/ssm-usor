---
import FluxLayout from '../../layouts/FluxLayout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<FluxLayout title={`${title} — SSM Ușor`} description={description}>
  <article class="legal wrap">
    <header>
      <h1>{title}</h1>
      <p class="updated">Ultima actualizare: {updated}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</FluxLayout>

<style>
  .legal {
    max-width: 760px;
    padding: 64px 0 96px;
  }
  header {
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    margin-bottom: 12px;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 1.05;
  }
  .updated {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .prose {
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .prose :global(h2) {
    margin: 44px 0 14px;
    font-size: 1.6rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin: 0 0 14px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 14px;
    padding-left: 22px;
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
  .prose :global(li::marker) {
    color: var(--ink-2);
  }
  .prose :global(mark) {
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--lime-soft);
    color: var(--ink);
  }
  .prose :global(a) {
    text-underline-offset: 3px;
  }
  .prose :global(.note) {
    margin: 0 0 28px;
    padding: 14px 18px;
    border-left: 3px solid var(--lime);
    background: var(--cream);
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  @media (max-width: 760px) {
    .legal {
      padding: 40px 0 64px;
    }
  }
</style>
