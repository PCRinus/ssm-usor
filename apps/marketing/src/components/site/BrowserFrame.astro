---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths: number[];
  address?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes, widths, address, eager = false, class: className } = Astro.props;
---

<div class:list={['browser', className]}>
  {address && (
    <div class="chrome">
      <span class="addr">{address}</span>
    </div>
  )}
  <Picture
    src={src}
    alt={alt}
    widths={widths.filter((width) => width <= src.width)}
    sizes={sizes}
    formats={['avif']}
    fallbackFormat="webp"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
  />
</div>

<style>
  .browser {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 24px 48px -24px rgba(24, 52, 46, 0.35);
    overflow: hidden;
  }
  .chrome {
    display: flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
  }
  .addr {
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--cream);
    color: #7b8782;
    font-size: 11px;
    line-height: 1.55;
  }
  .browser :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
