---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptSwitcher from './ConceptSwitcher.astro';
import {
  alsoIncluded,
  audience,
  cta,
  documentGroups,
  documentsNote,
  faq,
  links,
  reasons,
  signatureNote,
  signers,
  status,
  steps,
  trust,
} from './content';

const scattered = [
  { label: 'Word', x: 6, y: 8, r: -6 },
  { label: 'Excel', x: 58, y: 2, r: 4 },
  { label: 'PDF', x: 30, y: 30, r: 3 },
  { label: 'Email', x: 70, y: 40, r: -5 },
  { label: 'Aplicație de semnare', x: 4, y: 58, r: 5 },
  { label: 'WhatsApp', x: 52, y: 72, r: -3 },
  { label: 'Dosar fizic', x: 22, y: 80, r: 2 },
  { label: 'Calendar', x: 72, y: 82, r: 6 },
];
---

<BaseLayout
  title="SSM Ușor — Word, PDF, email, semnare, arhivă. Sau un singur flux."
  description="Adaugi clientul, adaugi angajații, creezi documentele și testele, semnezi electronic cu administratorul și cu fiecare angajat. Pentru servicii externe SSM din România."
  themeColor="#ffffff"
  noindex
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Source+Sans+3:wght@400;500;600&display=swap"
    />
  </Fragment>

  <div class="flux">
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/concepte/un-singur-flux/" aria-label="SSM Ușor">
          <img src="/brand/logo.png" alt="SSM Ușor" width="150" height="50" />
        </a>
        <nav aria-label="Secțiuni">
          <a href="#cum">Cum funcționează</a>
          <a href="#documente">Documente</a>
          <a href="#semnaturi">Semnături</a>
          <a href="#intrebari">Întrebări</a>
        </nav>
        <div class="auth">
          <a class="button quiet small" href={links.login}>{cta.login}</a>
          <span class="button primary small soon" aria-disabled="true">
            {cta.signup}
            <small>{cta.signupNote}</small>
          </span>
        </div>
      </div>
    </header>

    <main>
      <section class="hero wrap">
        <p class="status">{status.short}</p>
        <h1>Word, PDF, email, semnare, arhivă. Sau un singur flux.</h1>
        <p class="lede">
          Adaugi clientul, adaugi angajații, creezi contractele, documentele și testele, apoi
          semnezi electronic cu administratorul firmei și cu fiecare angajat. Totul într-un singur
          loc, pentru toți clienții tăi.
        </p>
        <div class="actions">
          <a class="button primary" href={links.login}>{cta.login}</a>
          <span class="button quiet soon" aria-disabled="true">
            {cta.signup}
            <small>{cta.signupNote}</small>
          </span>
        </div>
        <p class="notify"><a href={links.notifyHref}>{cta.notify}</a></p>

        <figure class="before-after" aria-label="Fluxul de azi față de fluxul din SSM Ușor">
          <div class="before">
            <p class="panel-title">Azi</p>
            <div class="scatter" aria-hidden="true">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M12 14 C 40 5, 45 45, 66 44"></path>
                <path d="M66 44 C 80 60, 30 60, 12 62"></path>
                <path d="M12 62 C 5 80, 40 70, 58 76"></path>
                <path d="M58 76 C 70 90, 40 100, 28 92"></path>
                <path d="M34 34 C 20 20, 60 10, 62 6"></path>
                <path d="M34 34 C 50 50, 60 90, 80 96"></path>
                <path d="M62 6 C 90 20, 85 40, 66 44"></path>
              </svg>
              {
                scattered.map((tile) => (
                  <span style={`left:${tile.x}%; top:${tile.y}%; --r:${tile.r}deg`}>
                    {tile.label}
                  </span>
                ))
              }
            </div>
            <p class="panel-note">
              Fiecare unealtă are propria copie a datelor. Fiecare trecere pierde ceva.
            </p>
          </div>
          <div class="after">
            <p class="panel-title">În SSM Ușor</p>
            <ol class="line">
              {
                steps.map((step) => (
                  <li>
                    <b>{step.title}</b>
                    <span>{step.text}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </figure>
        <p class="audience">{audience}</p>
      </section>

      <div class="thread">
        <section class="reading" id="cum">
          <span class="dot" aria-hidden="true"></span>
          <h2>Ce dispare din ziua ta de lucru.</h2>
          <p class="intro">
            Nu instrumentele sunt problema, ci trecerea între ele. Când clientul, angajații,
            documentele și semnăturile stau în același loc, patru lucruri dispar de la sine.
          </p>
          <ul class="list">
            {
              reasons.map((reason) => (
                <li>
                  <h3>{reason.title}</h3>
                  <p>{reason.text}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="reading wide" id="documente">
          <span class="dot" aria-hidden="true"></span>
          <h2>Ce poți face în platformă.</h2>
          <p class="intro">{documentsNote}</p>
          <div class="doc-groups">
            {
              documentGroups.map((group) => (
                <div>
                  <h3>{group.title}</h3>
                  <ul>
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </section>

        <section class="reading" id="semnaturi">
          <span class="dot" aria-hidden="true"></span>
          <h2>Cine semnează ce.</h2>
          <p class="intro">{signatureNote}</p>
          <dl class="signers">
            {
              signers.map((signer) => (
                <div>
                  <dt>{signer.who}</dt>
                  <dd>{signer.signs}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="reading wide" id="restul">
          <span class="dot" aria-hidden="true"></span>
          <h2>Și restul, când ai nevoie.</h2>
          <p class="intro">
            Fluxul de mai sus este ceea ce faci zilnic. În jurul lui, platforma ține evidența pentru
            toți clienții odată.
          </p>
          <ul class="also">
            {
              alsoIncluded.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="reading" id="cont">
          <span class="dot end" aria-hidden="true"></span>
          <h2>Conturile noi se deschid în curând.</h2>
          <p class="intro">{status.long}</p>
          <div class="actions start">
            <a class="button primary" href={links.login}>{cta.login}</a>
            <a class="button quiet" href={links.notifyHref}>{cta.notify}</a>
          </div>
        </section>
      </div>

      <section class="trust">
        <div class="wrap">
          <ul>
            {
              trust.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="faq wrap" id="intrebari">
        <h2>Întrebări frecvente</h2>
        <div class="faq-list">
          {
            faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <img src="/brand/logo.png" alt="SSM Ușor" width="130" height="43" />
        <p>
          Platforma de lucru pentru servicii externe SSM din România. Scrie-ne la
          <a href={`mailto:${links.email}`}>{links.email}</a>.
        </p>
        <p class="fine">
          SSM Ușor nu oferă consultanță juridică și nu înlocuiește responsabilitatea specialistului
          autorizat. Exemplele de pe această pagină sunt ilustrative.
        </p>
      </div>
    </footer>
  </div>

  <ConceptSwitcher current="un-singur-flux" />
</BaseLayout>

<style>
  :global(body) {
    background: #ffffff;
  }
  .flux {
    --ink: #18342e;
    --ink-2: #5b6b64;
    --cream: #f8f7f1;
    --line: #d7ddd4;
    --lime: #b6d86f;
    --lime-soft: #e6f0cf;
    --sage: #9fb39c;
    --moss: #2a5045;
    --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
    --sans: 'Source Sans 3', ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 18px;
    line-height: 1.55;
    overflow-x: clip;
  }
  .wrap {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }
  h1,
  h2,
  h3 {
    margin: 0;
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  p {
    margin: 0;
  }
  a {
    color: inherit;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .button.primary {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .button.primary:hover {
    background: var(--moss);
  }
  .button.quiet {
    border-color: var(--line);
  }
  .button.quiet:hover {
    border-color: var(--ink);
  }
  .button.small {
    min-height: 40px;
    padding: 0 16px;
    font-size: 0.92rem;
  }
  .button.soon {
    cursor: default;
    opacity: 0.75;
  }
  .button.soon small {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--lime);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .actions.start {
    justify-content: flex-start;
  }
  .auth {
    display: flex;
    gap: 8px;
  }

  .top {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
  }
  .brand img {
    width: 150px;
    height: auto;
  }
  .bar nav {
    display: flex;
    gap: 28px;
    font-size: 0.98rem;
  }
  .bar nav a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .bar nav a:hover {
    color: var(--ink);
  }

  /* Hero, centered */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 80px 0 56px;
    text-align: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .status::before {
    content: '';
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
  }
  h1 {
    max-width: 20ch;
    font-size: clamp(2.6rem, 5.6vw, 4.8rem);
    line-height: 1.02;
  }
  .lede {
    max-width: 58ch;
    margin: 28px 0 32px;
    font-family: var(--serif);
    font-size: 1.32rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .notify {
    margin-top: 16px;
    font-size: 0.95rem;
  }
  .notify a {
    color: var(--ink-2);
    text-underline-offset: 3px;
  }
  .audience {
    max-width: 58ch;
    margin-top: 36px;
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  .before-after {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    width: 100%;
    margin: 56px 0 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    text-align: left;
  }
  .before,
  .after {
    padding: 28px 32px 32px;
  }
  .before {
    background: var(--cream);
    border-right: 1px solid var(--line);
  }
  .after {
    background: #fff;
  }
  .panel-title {
    margin-bottom: 20px;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 500;
  }
  .scatter {
    position: relative;
    height: 320px;
  }
  .scatter svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--sage);
    stroke-width: 0.6;
    stroke-dasharray: 2 2;
    vector-effect: non-scaling-stroke;
  }
  .scatter span {
    position: absolute;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
    font-size: 0.9rem;
    color: var(--ink);
    transform: rotate(var(--r));
    box-shadow: 0 2px 0 var(--line);
    white-space: nowrap;
  }
  .panel-note {
    margin-top: 28px;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .line {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .line li {
    position: relative;
    padding: 0 0 20px 30px;
  }
  .line li::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--lime);
  }
  .line li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 21px;
    bottom: -2px;
    left: 5px;
    border-left: 2px solid var(--lime);
  }
  .line b {
    display: block;
    font-weight: 600;
  }
  .line span {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  /* Thread */
  .thread {
    position: relative;
    width: min(1120px, calc(100% - 40px));
    margin: 40px auto 0;
    padding-left: 72px;
  }
  .thread::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 5px;
    border-left: 2px solid var(--lime);
  }
  .reading {
    position: relative;
    max-width: 66ch;
    padding: 56px 0;
  }
  .reading.wide {
    max-width: none;
  }
  .dot {
    position: absolute;
    top: 68px;
    left: -72px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--lime);
  }
  .dot.end {
    background: var(--ink);
  }
  .reading h2 {
    margin-bottom: 18px;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    line-height: 1.1;
  }
  .intro {
    max-width: 66ch;
    margin-bottom: 32px;
    font-family: var(--serif);
    font-size: 1.22rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .reading h3 {
    font-family: var(--sans);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list li {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .list p {
    margin-top: 6px;
    color: var(--ink-2);
  }
  .doc-groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .doc-groups h3 {
    margin-bottom: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--ink);
  }
  .doc-groups ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .doc-groups li {
    padding: 8px 0;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }
  .signers {
    margin: 0;
  }
  .signers div {
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .signers dt {
    font-weight: 600;
    font-size: 1.12rem;
  }
  .signers dd {
    margin: 6px 0 0;
    color: var(--ink-2);
  }
  .also {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .also li {
    padding-top: 12px;
    border-top: 1px solid var(--sage);
  }
  .also p {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  .trust {
    margin-top: 56px;
    padding: 72px 0;
    background: var(--ink);
    color: #eef6f2;
  }
  .trust ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust h3 {
    margin-bottom: 8px;
    padding-top: 14px;
    border-top: 1px solid #3a5a50;
    font-family: var(--sans);
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: 0;
    color: #fff;
  }
  .trust p {
    color: #b7c8c1;
    font-size: 0.98rem;
  }

  .faq {
    padding: 80px 0 96px;
  }
  .faq h2 {
    margin-bottom: 24px;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
  }
  .faq-list {
    max-width: 760px;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex-shrink: 0;
    color: var(--ink-2);
  }
  details[open] summary::after {
    content: '–';
  }
  details p {
    max-width: 66ch;
    padding-bottom: 20px;
    color: var(--ink-2);
  }

  .foot {
    padding: 40px 0 72px;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 160px 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .foot-grid img {
    width: 130px;
    height: auto;
  }
  .fine {
    color: var(--ink-2);
    font-size: 0.88rem;
  }

  @media (max-width: 1080px) {
    .also {
      grid-template-columns: 1fr 1fr;
    }
    .doc-groups {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 760px) {
    .flux {
      font-size: 17px;
    }
    .wrap {
      width: min(100% - 32px, 1120px);
    }
    .bar nav,
    .auth .soon {
      display: none;
    }
    .hero {
      padding-top: 48px;
    }
    h1 {
      font-size: clamp(2.2rem, 10vw, 3rem);
    }
    .lede {
      font-size: 1.15rem;
    }
    .before-after {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
    .before {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .before,
    .after {
      padding: 22px 20px 24px;
    }
    .scatter {
      height: 280px;
    }
    .scatter span {
      font-size: 0.82rem;
      padding: 6px 9px;
    }
    .thread {
      width: min(100% - 32px, 1120px);
      padding-left: 28px;
    }
    .thread::before {
      left: 4px;
    }
    .dot {
      left: -29px;
      top: 60px;
    }
    .reading {
      padding: 44px 0;
    }
    .also,
    .trust ul,
    .foot-grid {
      grid-template-columns: 1fr;
    }
    .actions .button {
      width: 100%;
      justify-content: center;
    }
    .trust,
    .faq {
      padding-block: 64px;
    }
  }
</style>
