---
/**
 * Small fixed bar for previewing the landing-page concept next to the current page.
 * Rendered only on /concepte pages; those pages are noindex and excluded from the sitemap.
 */
interface Props {
  current: 'actual' | 'fluxul';
}

const { current } = Astro.props;

const items = [
  { key: 'actual', label: 'Pagina actuală', href: '/' },
  { key: 'fluxul', label: 'Concept E', href: '/concepte/fluxul/' },
] as const;
---

<nav class="concept-switcher" aria-label="Concepte de design">
  {
    items.map((item) => (
      <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
        {item.label}
      </a>
    ))
  }
</nav>

<style>
  .concept-switcher {
    position: fixed;
    bottom: 12px;
    left: 12px;
    z-index: 50;
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 10px;
    background: #18342e;
    box-shadow: 0 8px 24px rgb(0 0 0 / 25%);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 12px;
    line-height: 1;
  }
  .concept-switcher a {
    padding: 8px 10px;
    border-radius: 7px;
    color: #cfdad5;
    text-decoration: none;
    white-space: nowrap;
  }
  .concept-switcher a:hover {
    background: #2a5045;
    color: #fff;
  }
  .concept-switcher a[aria-current='page'] {
    background: #b6d86f;
    color: #18342e;
    font-weight: 600;
  }
  @media print {
    .concept-switcher {
      display: none;
    }
  }
</style>
