---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptSwitcher from './ConceptSwitcher.astro';
import {
  alsoIncluded,
  audience,
  cta,
  documentGroups,
  documentsNote,
  faq,
  links,
  reasons,
  signatureNote,
  signers,
  status,
  steps,
  trust,
} from './content';
---

<BaseLayout
  title="SSM Ușor — Documentele SSM ale clienților tăi, făcute și semnate într-un singur loc"
  description="Adaugi clientul, adaugi angajații, creezi documentele și testele, semnezi electronic cu administratorul și cu fiecare angajat. Pentru servicii externe SSM din România."
  themeColor="#f8f7f1"
  noindex
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
  </Fragment>

  <div class="doc">
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/concepte/documentul/" aria-label="SSM Ușor">
          <img src="/brand/logo.png" alt="SSM Ușor" width="150" height="50" />
        </a>
        <nav aria-label="Secțiuni">
          <a href="#cum">Cum funcționează</a>
          <a href="#documente">Documente</a>
          <a href="#semnaturi">Semnături</a>
          <a href="#intrebari">Întrebări</a>
        </nav>
        <div class="auth">
          <a class="button quiet small" href={links.login}>{cta.login}</a>
          <span class="button primary small soon" aria-disabled="true">
            {cta.signup}
            <small>{cta.signupNote}</small>
          </span>
        </div>
      </div>
    </header>

    <main>
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="status">{status.short}</p>
          <h1>Documentele SSM ale clienților tăi, făcute și semnate într-un singur loc.</h1>
          <p class="lede">
            Adaugi clientul, adaugi angajații, creezi contractele, documentele și testele, apoi
            semnezi electronic cu administratorul firmei și cu fiecare angajat. Fără Word, fără
            PDF-uri trimise pe email, fără drumuri pentru o semnătură.
          </p>
          <div class="actions">
            <a class="button primary" href={links.login}>{cta.login}</a>
            <span class="button quiet soon" aria-disabled="true">
              {cta.signup}
              <small>{cta.signupNote}</small>
            </span>
          </div>
          <p class="notify">
            <a href={links.notifyHref}>{cta.notify}</a>
          </p>
          <p class="audience">{audience}</p>
        </div>

        <figure
          class="sheet"
          aria-label="Exemplu de fișă de instruire generată și semnată în platformă"
        >
          <ul class="callouts" aria-label="Ce se vede în document">
            <li class="c1">Datele firmei și ale angajatului, completate automat</li>
            <li class="c2">Testul promovat, trecut direct în fișă</li>
            <li class="c3">Semnată de angajat, de tine și de administrator</li>
          </ul>
          <div class="tabs" aria-hidden="true">
            <span class="on">Versiunea în vigoare</span>
            <span>Istoric</span>
          </div>
          <div class="paper">
            <div class="paper-head">
              <p class="issuer">
                Prevent Consult SRL
                <small>Serviciu extern de prevenire și protecție</small>
              </p>
              <p class="meta">
                Fișă instruire SSM
                <small>Generată 12 sept. 2026</small>
              </p>
            </div>
            <h2>Fișă de instruire individuală privind securitatea și sănătatea în muncă</h2>
            <dl class="fields">
              <dt>Angajator</dt>
              <dd><mark>Metalcon Prod SRL</mark></dd>
              <dt>Punct de lucru</dt>
              <dd><mark>Hala 2, str. Fabricii 14, Cluj-Napoca</mark></dd>
              <dt>Numele și prenumele</dt>
              <dd><mark>Ioana Popescu</mark></dd>
              <dt>Funcția</dt>
              <dd><mark>Lăcătuș mecanic</mark></dd>
              <dt>Data angajării</dt>
              <dd><mark>1 sept. 2026</mark></dd>
            </dl>
            <div class="block">
              <h3>Instruirea introductiv-generală</h3>
              <p>
                Efectuată în <mark>2 sept. 2026</mark>, cu durata de <mark>8 ore</mark>, de către
                <mark>Andrei Marin</mark>, specialist SSM. Verificarea cunoștințelor:
                <mark>18 din 20, promovat</mark>.
              </p>
            </div>
            <div class="block">
              <h3>Instruirea la locul de muncă</h3>
              <p>
                Efectuată în <mark>3 sept. 2026</mark> de <mark>Vasile Nistor</mark>, conducătorul
                locului de muncă, după instrucțiunea proprie <mark>IPSSM-07</mark>.
              </p>
            </div>
            <div class="signatures">
              <div>
                <span>Persoana instruită</span>
                <b>Ioana Popescu</b>
                <i class="done">Semnat 2 sept. 2026, 14:32</i>
              </div>
              <div>
                <span>Specialist SSM</span>
                <b>Andrei Marin</b>
                <i class="done">Semnat 2 sept. 2026, 15:05</i>
              </div>
              <div>
                <span>Administrator</span>
                <b>Vasile Nistor</b>
                <i class="done">Semnat 3 sept. 2026, 09:10</i>
              </div>
            </div>
            <p class="hash">Semnături electronice validate. Document verificabil oricând.</p>
          </div>
          <figcaption>Exemplu ilustrativ. Firmele și persoanele sunt fictive.</figcaption>
        </figure>
      </section>

      <section class="steps-section" id="cum">
        <div class="wrap">
          <div class="section-head">
            <h2>Patru pași, pentru fiecare client.</h2>
            <p>
              Același drum, de la firma nouă la dosarul complet. Datele pe care le scrii la primul
              pas ajung singure în toate documentele de la pasul trei.
            </p>
          </div>
          <ol class="steps">
            {
              steps.map((step, index) => (
                <li>
                  <span class="n">{index + 1}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="documents wrap" id="documente">
        <div class="section-head">
          <h2>Ce poți face în platformă.</h2>
          <p>{documentsNote}</p>
        </div>
        <div class="doc-groups">
          {
            documentGroups.map((group) => (
              <div>
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="signers-section" id="semnaturi">
        <div class="wrap">
          <div class="section-head">
            <h2>Cine semnează ce.</h2>
            <p>{signatureNote}</p>
          </div>
          <dl class="signers">
            {
              signers.map((signer) => (
                <div>
                  <dt>{signer.who}</dt>
                  <dd>{signer.signs}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="reasons wrap">
        <h2>Ce dispare din ziua ta de lucru.</h2>
        <dl>
          {
            reasons.map((reason) => (
              <div>
                <dt>{reason.title}</dt>
                <dd>{reason.text}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="also">
        <div class="wrap also-grid">
          <div>
            <h2>Și restul, când ai nevoie.</h2>
            <p>
              Fluxul de mai sus este ceea ce faci zilnic. În jurul lui, platforma ține evidența
              pentru toți clienții odată.
            </p>
          </div>
          <dl>
            {
              alsoIncluded.map((item) => (
                <div>
                  <dt>{item.title}</dt>
                  <dd>{item.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="access wrap" id="cont">
        <div class="access-box">
          <div>
            <h2>Conturile noi se deschid în curând.</h2>
            <p>{status.long}</p>
          </div>
          <div class="actions">
            <a class="button primary" href={links.login}>{cta.login}</a>
            <a class="button quiet" href={links.notifyHref}>{cta.notify}</a>
          </div>
        </div>
      </section>

      <section class="trust wrap">
        <dl>
          {
            trust.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd>{item.text}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="faq wrap" id="intrebari">
        <h2>Întrebări frecvente</h2>
        <div class="faq-list">
          {
            faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <img src="/brand/logo.png" alt="SSM Ușor" width="130" height="43" />
        <p>
          Platforma de lucru pentru servicii externe SSM din România. Scrie-ne la
          <a href={`mailto:${links.email}`}>{links.email}</a>.
        </p>
        <p class="fine">
          Documentele afișate pe această pagină sunt exemple ilustrative. SSM Ușor nu oferă
          consultanță juridică și nu înlocuiește responsabilitatea specialistului autorizat.
        </p>
      </div>
    </footer>
  </div>

  <ConceptSwitcher current="documentul" />
</BaseLayout>

<style>
  :global(body) {
    background: #f8f7f1;
  }
  .doc {
    --ink: #18342e;
    --ink-2: #5b6b64;
    --paper: #ffffff;
    --cream: #f8f7f1;
    --line: #d7ddd4;
    --lime: #b6d86f;
    --lime-soft: #e6f0cf;
    --sage: #9fb39c;
    --moss: #2a5045;
    color: var(--ink);
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.55;
    overflow-x: clip;
  }
  .wrap {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }
  h1,
  h2,
  h3 {
    margin: 0;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  p {
    margin: 0;
  }
  a {
    color: inherit;
  }

  /* Buttons */
  .button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.98rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .button.primary {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--ink);
  }
  .button.primary:hover {
    background: #a9cc61;
  }
  .button.quiet {
    border-color: var(--ink);
  }
  .button.quiet:hover {
    background: #eceee7;
  }
  .button.small {
    min-height: 40px;
    padding: 0 14px;
    font-size: 0.9rem;
  }
  .button.soon {
    cursor: default;
    opacity: 0.7;
  }
  .button.soon small {
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    font-size: 0.7rem;
    font-weight: 500;
  }
  .button.primary.soon small {
    background: var(--ink);
  }
  .button.quiet.soon small {
    background: var(--line);
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .auth {
    display: flex;
    gap: 8px;
  }

  /* Header */
  .top {
    border-bottom: 1px solid var(--line);
    background: var(--cream);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
  }
  .brand img {
    width: 150px;
    height: auto;
  }
  .bar nav {
    display: flex;
    gap: 26px;
    font-size: 0.95rem;
  }
  .bar nav a {
    text-decoration: none;
    color: var(--ink-2);
  }
  .bar nav a:hover {
    color: var(--ink);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: start;
    padding: 72px 0 40px;
  }
  .hero-copy {
    padding-top: 32px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .status::before {
    content: '';
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    outline: 3px solid var(--lime-soft);
  }
  h1 {
    max-width: 16ch;
    font-size: clamp(2.4rem, 4.3vw, 3.6rem);
    line-height: 1.06;
  }
  .lede {
    max-width: 52ch;
    margin: 26px 0 30px;
    font-size: 1.1rem;
    color: var(--ink-2);
  }
  .notify {
    margin-top: 16px;
    font-size: 0.95rem;
  }
  .notify a {
    color: var(--ink-2);
    text-underline-offset: 3px;
  }
  .audience {
    max-width: 48ch;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  /* The document */
  .sheet {
    position: relative;
    margin: 0;
    padding-left: 176px;
  }
  .callouts {
    position: absolute;
    top: 0;
    left: 0;
    width: 150px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .callouts li {
    position: absolute;
    left: 0;
    width: 150px;
    padding-right: 10px;
    text-align: right;
  }
  .callouts li::after {
    content: '';
    position: absolute;
    top: 9px;
    right: -26px;
    width: 22px;
    border-top: 1px solid var(--sage);
  }
  .callouts .c1 {
    top: 150px;
  }
  .callouts .c2 {
    top: 350px;
  }
  .callouts .c3 {
    top: 520px;
  }
  .tabs {
    display: flex;
    gap: 4px;
    font-size: 0.78rem;
  }
  .tabs span {
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    background: #eeeee8;
    color: var(--ink-2);
  }
  .tabs .on {
    background: var(--paper);
    color: var(--ink);
    font-weight: 500;
  }
  .paper {
    padding: 34px 38px 28px;
    border: 1px solid var(--line);
    border-radius: 0 10px 10px 10px;
    background: var(--paper);
    box-shadow:
      0 1px 0 var(--line),
      0 24px 50px -30px rgb(24 52 46 / 35%);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .paper-head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .paper-head p {
    font-weight: 500;
  }
  .paper-head small {
    display: block;
    font-weight: 400;
    color: var(--ink-2);
  }
  .paper-head .meta {
    flex-shrink: 0;
    text-align: right;
    font-weight: 400;
    color: var(--ink-2);
  }
  .paper h2 {
    margin: 22px 0 18px;
    font-size: 1.12rem;
    line-height: 1.3;
    letter-spacing: 0;
  }
  .fields {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 7px 16px;
    margin: 0 0 20px;
  }
  .fields dt {
    color: var(--ink-2);
  }
  .fields dd {
    margin: 0;
  }
  mark {
    padding: 1px 4px;
    border-radius: 3px;
    background: var(--lime-soft);
    color: inherit;
    box-shadow: inset 0 -1px 0 var(--lime);
  }
  .block {
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }
  .block h3 {
    margin-bottom: 6px;
    font-size: 0.9rem;
    letter-spacing: 0;
  }
  .signatures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 8px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .signatures span {
    display: block;
    font-size: 0.74rem;
    color: var(--ink-2);
  }
  .signatures b {
    display: block;
    margin: 4px 0 8px;
    font-weight: 500;
  }
  .signatures i {
    display: block;
    padding-top: 8px;
    border-top: 1px solid var(--lime);
    font-size: 0.74rem;
    font-style: normal;
    color: var(--moss);
  }
  .hash {
    margin-top: 12px;
    font-size: 0.74rem;
    color: var(--ink-2);
  }
  figcaption {
    margin-top: 12px;
    font-size: 0.82rem;
    color: var(--ink-2);
  }

  /* Section heads */
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 44px;
  }
  .section-head h2,
  .reasons h2,
  .also h2,
  .access h2,
  .faq h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.1;
  }
  .section-head p {
    max-width: 52ch;
    color: var(--ink-2);
  }

  /* Steps */
  .steps-section {
    padding: 96px 0;
    background: var(--ink);
    color: #eef6f2;
  }
  .steps-section .section-head p {
    color: #b7c8c1;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    padding-top: 18px;
    border-top: 1px solid #3a5a50;
  }
  .steps li:last-child {
    border-top-color: var(--lime);
  }
  .n {
    display: block;
    margin-bottom: 36px;
    font-size: 0.85rem;
    color: var(--lime);
  }
  .steps h3 {
    margin-bottom: 10px;
    font-size: 1.25rem;
    color: #fff;
  }
  .steps p {
    color: #b7c8c1;
    font-size: 0.95rem;
  }

  /* Documents */
  .documents {
    padding: 96px 0;
  }
  .doc-groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .doc-groups h3 {
    margin-bottom: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--ink);
    font-size: 1.15rem;
  }
  .doc-groups ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .doc-groups li {
    padding: 9px 0;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  /* Signers */
  .signers-section {
    padding: 96px 0;
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .signers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin: 0;
  }
  .signers div {
    padding: 22px 24px;
    border-radius: 10px;
    background: var(--cream);
  }
  .signers dt {
    margin-bottom: 8px;
    font-size: 1.15rem;
    font-weight: 500;
  }
  .signers dd {
    margin: 0;
    color: var(--ink-2);
  }

  /* Reasons */
  .reasons {
    padding: 96px 0 72px;
  }
  .reasons h2 {
    max-width: 22ch;
    margin-bottom: 40px;
  }
  .reasons dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 56px;
    margin: 0;
  }
  .reasons div {
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }
  .reasons dt {
    margin-bottom: 6px;
    font-size: 1.15rem;
    font-weight: 500;
  }
  .reasons dd {
    margin: 0;
    color: var(--ink-2);
  }

  /* Also included */
  .also {
    padding: 72px 0;
    background: #eef0e9;
  }
  .also-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
  }
  .also h2 {
    margin-bottom: 12px;
  }
  .also-grid > div > p {
    max-width: 44ch;
    color: var(--ink-2);
  }
  .also dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 32px;
    margin: 0;
  }
  .also dl div {
    padding-top: 12px;
    border-top: 1px solid var(--sage);
  }
  .also dt {
    margin-bottom: 4px;
    font-weight: 500;
  }
  .also dd {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  /* Access */
  .access {
    padding: 96px 0 40px;
  }
  .access-box {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px;
    align-items: center;
    padding: 40px 44px;
    border: 1px solid var(--ink);
    border-radius: 12px;
  }
  .access h2 {
