---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptSwitcher from './ConceptSwitcher.astro';
import {
  alsoIncluded,
  audience,
  cta,
  documentGroups,
  documentsNote,
  faq,
  links,
  reasons,
  signatureNote,
  signers,
  status,
  steps,
  trust,
} from './content';

const employees = [
  ['Ioana Popescu', 'Lăcătuș mecanic'],
  ['Mihai Dobre', 'Operator CNC'],
  ['Elena Rusu', 'Gestionar depozit'],
  ['Radu Iancu', 'Electrician'],
];

const documents = [
  ['Contract de servicii', 'semnat'],
  ['Fișe de instruire', '38 generate'],
  ['Instrucțiune proprie IPSSM-07', 'în vigoare'],
  ['Test introductiv', '36 din 38 promovat'],
];

const signatures = [
  ['Angajați', 36, 38],
  ['Specialist SSM', 38, 38],
  ['Administrator', 1, 1],
];
---

<BaseLayout
  title="SSM Ușor — Tot ce faci pentru un client SSM, pas cu pas, într-un singur loc"
  description="Adaugi clientul, adaugi angajații, creezi documentele și testele, semnezi electronic cu administratorul și cu fiecare angajat. Pentru servicii externe SSM din România."
  themeColor="#18342e"
  noindex
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600&display=swap"
    />
  </Fragment>

  <div class="ops">
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/concepte/portofoliul/" aria-label="SSM Ușor">
          <img src="/brand/logo.png" alt="SSM Ușor" width="150" height="50" />
        </a>
        <nav aria-label="Secțiuni">
          <a href="#cum">Cum funcționează</a>
          <a href="#documente">Documente</a>
          <a href="#semnaturi">Semnături</a>
          <a href="#intrebari">Întrebări</a>
        </nav>
        <div class="auth">
          <a class="button ghost small" href={links.login}>{cta.login}</a>
          <span class="button primary small soon" aria-disabled="true">
            {cta.signup}
            <small>{cta.signupNote}</small>
          </span>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <div class="hero-copy">
            <p class="status">{status.short}</p>
            <h1>Tot ce faci pentru un client SSM, pas cu pas, într-un singur loc.</h1>
            <p class="lede">
              Adaugi clientul, adaugi angajații, creezi contractele, documentele și testele, apoi
              semnezi electronic cu administratorul firmei și cu fiecare angajat. Fără Word, fără
              PDF-uri pe email, fără drumuri pentru o semnătură.
            </p>
            <div class="actions">
              <a class="button primary" href={links.login}>{cta.login}</a>
              <span class="button ghost soon" aria-disabled="true">
                {cta.signup}
                <small>{cta.signupNote}</small>
              </span>
            </div>
            <p class="notify"><a href={links.notifyHref}>{cta.notify}</a></p>
          </div>

          <figure class="walk" aria-label="Cei patru pași, așa cum arată în platformă">
            <ol>
              <li>
                <span class="step-label">1. Client</span>
                <div class="panel client">
                  <b>Metalcon Prod SRL</b>
                  <span>CUI 12345678</span>
                  <span>2 puncte de lucru, Cluj-Napoca</span>
                  <span>Contact: Vasile Nistor, administrator</span>
                  <i>Contract semnat</i>
                </div>
              </li>
              <li>
                <span class="step-label">2. Angajați</span>
                <div class="panel people">
                  {
                    employees.map(([name, role]) => (
                      <div>
                        <b>{name}</b>
                        <span>{role}</span>
                      </div>
                    ))
                  }
                  <p>și încă 34</p>
                </div>
              </li>
              <li>
                <span class="step-label">3. Documente și teste</span>
                <div class="panel docs">
                  {
                    documents.map(([name, state]) => (
                      <div>
                        <b>{name}</b>
                        <span>{state}</span>
                      </div>
                    ))
                  }
                </div>
              </li>
              <li>
                <span class="step-label">4. Semnături</span>
                <div class="panel signs">
                  {
                    signatures.map(([who, done, total]) => (
                      <div>
                        <b>{who}</b>
                        <span>
                          {done} din {total}
                        </span>
                        <i style={`--p:${(Number(done) / Number(total)) * 100}%`} />
                      </div>
                    ))
                  }
                </div>
              </li>
            </ol>
            <figcaption>Exemplu ilustrativ. Firmele și persoanele sunt fictive.</figcaption>
          </figure>
        </div>
      </section>

      <section class="audience-band">
        <div class="wrap">
          <p>{audience}</p>
        </div>
      </section>

      <section class="steps-section wrap" id="cum">
        <div class="section-head">
          <h2>Patru pași, pentru fiecare client.</h2>
          <p>
            Același drum, de la firma nouă la dosarul complet. Datele pe care le scrii la primul pas
            ajung singure în toate documentele de la pasul trei.
          </p>
        </div>
        <ol class="steps">
          {
            steps.map((step, index) => (
              <li>
                <span class="n">{index + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="documents" id="documente">
        <div class="wrap">
          <div class="section-head">
            <h2>Ce poți face în platformă.</h2>
            <p>{documentsNote}</p>
          </div>
          <div class="doc-groups">
            {
              documentGroups.map((group) => (
                <div>
                  <h3>{group.title}</h3>
                  <ul>
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="signers-section wrap" id="semnaturi">
        <div class="section-head">
          <h2>Cine semnează ce.</h2>
          <p>{signatureNote}</p>
        </div>
        <table class="signers">
          <tbody>
            {
              signers.map((signer) => (
                <tr>
                  <th scope="row">{signer.who}</th>
                  <td>{signer.signs}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section class="reasons">
        <div class="wrap">
          <h2>Ce dispare din ziua ta de lucru.</h2>
          <ul>
            {
              reasons.map((reason) => (
                <li>
                  <h3>{reason.title}</h3>
                  <p>{reason.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="also wrap">
        <div class="section-head">
          <h2>Și restul, când ai nevoie.</h2>
          <p>
            Fluxul de mai sus este ceea ce faci zilnic. În jurul lui, platforma ține evidența pentru
            toți clienții odată.
          </p>
        </div>
        <ul class="also-list">
          {
            alsoIncluded.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="access" id="cont">
        <div class="wrap access-grid">
          <div>
            <h2>Conturile noi se deschid în curând.</h2>
            <p>{status.long}</p>
            <div class="actions">
              <a class="button primary" href={links.login}>{cta.login}</a>
              <a class="button ghost" href={links.notifyHref}>{cta.notify}</a>
            </div>
          </div>
          <ul class="trust">
            {
              trust.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="faq wrap" id="intrebari">
        <h2>Întrebări frecvente</h2>
        <div class="faq-list">
          {
            faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <img src="/brand/logo.png" alt="SSM Ușor" width="130" height="43" />
        <p>
          Platforma de lucru pentru servicii externe SSM din România. Scrie-ne la
          <a href={`mailto:${links.email}`}>{links.email}</a>.
        </p>
        <p class="fine">
          Exemplele afișate sunt ilustrative. SSM Ușor nu oferă consultanță juridică și nu
          înlocuiește responsabilitatea specialistului autorizat.
        </p>
      </div>
    </footer>
  </div>

  <ConceptSwitcher current="portofoliul" />
</BaseLayout>

<style>
  :global(body) {
    background: #f8f7f1;
  }
  .ops {
    --ink: #18342e;
    --ink-2: #5b6b64;
    --cream: #f8f7f1;
    --paper: #ffffff;
    --line: #d7ddd4;
    --lime: #b6d86f;
    --lime-soft: #e6f0cf;
    --sage: #9fb39c;
    --moss: #2a5045;
    --forest-line: #35564c;
    color: var(--ink);
    font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
    font-optical-sizing: auto;
    font-size: 17px;
    line-height: 1.5;
    overflow-x: clip;
  }
  .wrap {
    width: min(1240px, calc(100% - 40px));
    margin-inline: auto;
  }
  h1,
  h2,
  h3 {
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  p {
    margin: 0;
  }
  a {
    color: inherit;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 50px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .button.primary {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--ink);
  }
  .button.primary:hover {
    background: #a9cc61;
  }
  .button.ghost {
    border-color: currentColor;
  }
  .button.small {
    min-height: 40px;
    padding: 0 14px;
    font-size: 0.92rem;
  }
  .button.soon {
    cursor: default;
    opacity: 0.75;
  }
  .button.soon small {
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    font-size: 0.72rem;
    font-weight: 500;
  }
  .hero .button.ghost.soon small {
    background: var(--lime);
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .auth {
    display: flex;
    gap: 8px;
  }

  .top {
    background: var(--ink);
    color: #eef6f2;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
  }
  .brand {
    display: inline-flex;
    padding: 5px 9px;
    border-radius: 8px;
    background: var(--cream);
  }
  .brand img {
    width: 140px;
    height: auto;
  }
  .bar nav {
    display: flex;
    gap: 26px;
    font-size: 0.95rem;
  }
  .bar nav a {
    color: #c6d4ce;
    text-decoration: none;
  }
  .bar nav a:hover {
    color: #fff;
  }
  .top .ghost {
    color: #eef6f2;
    border-color: #5a7a6f;
  }

  /* Hero */
  .hero {
    padding: 56px 0 0;
    background: var(--ink);
    color: #eef6f2;
  }
  .hero-copy {
    max-width: 800px;
    padding-bottom: 48px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    font-size: 0.92rem;
    color: #b7c8c1;
  }
  .status::before {
    content: '';
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4.3rem);
    line-height: 1;
    color: #fff;
  }
  .lede {
    max-width: 60ch;
    margin: 24px 0 30px;
    font-size: 1.1rem;
    color: #c6d4ce;
  }
  .hero .ghost {
    color: #eef6f2;
    border-color: #5a7a6f;
  }
  .notify {
    margin-top: 16px;
    font-size: 0.95rem;
  }
  .notify a {
    color: #b7c8c1;
    text-underline-offset: 3px;
  }

  /* Walkthrough */
  .walk {
    margin: 0;
    transform: translateY(56px);
    margin-top: -56px;
  }
  .walk ol {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .walk li {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .walk li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 14px;
    right: -14px;
    width: 14px;
    border-top: 2px solid var(--lime);
  }
  .step-label {
    display: inline-block;
    margin-bottom: 10px;
    padding: 4px 10px;
    border-radius: 4px;
    background: var(--lime);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .panel {
    flex: 1;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.92rem;
  }
  .panel.client {
    display: grid;
    gap: 4px;
  }
  .panel.client b {
    font-size: 1.05rem;
    margin-bottom: 4px;
  }
  .panel.client span {
    color: var(--ink-2);
  }
  .panel.client i {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    color: var(--moss);
    font-style: normal;
    font-weight: 600;
  }
  .panel.people div,
  .panel.docs div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
  }
  .panel.people div:last-of-type,
  .panel.docs div:last-of-type {
    border-bottom: 0;
  }
  .panel.people span,
  .panel.docs span {
    flex-shrink: 0;
    color: var(--ink-2);
    text-align: right;
    font-size: 0.85rem;
  }
  .panel.people p {
    padding-top: 8px;
    color: var(--ink-2);
    font-size: 0.85rem;
  }
  .panel.signs div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    padding: 8px 0;
  }
  .panel.signs span {
    color: var(--ink-2);
    font-size: 0.85rem;
  }
  .panel.signs i {
    grid-column: 1 / -1;
    display: block;
    height: 6px;
    border-radius: 3px;
    background: #eef0e9;
    overflow: hidden;
  }
  .panel.signs i::before {
    content: '';
    display: block;
    width: var(--p);
    height: 100%;
    background: var(--lime);
  }
  .walk figcaption {
    padding: 14px 0 0;
    color: var(--ink-2);
    font-size: 0.85rem;
  }

  .audience-band {
    padding: 112px 0 0;
  }
  .audience-band p {
    max-width: 60ch;
    color: var(--ink-2);
    font-size: 1.05rem;
  }

  /* Sections */
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 40px;
  }
  .section-head h2,
  .reasons h2,
  .access h2,
  .faq h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    line-height: 1.05;
  }
  .section-head p {
    max-width: 52ch;
    color: var(--ink-2);
  }

  .steps-section {
    padding: 80px 0 96px;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .steps li {
    display: grid;
    grid-template-columns: 80px minmax(0, 4fr) minmax(0, 7fr);
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .steps li > div {
    display: contents;
  }
  .n {
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--lime);
    line-height: 1;
  }
  .steps h3 {
    font-size: 1.35rem;
  }
  .steps p {
    color: var(--ink-2);
  }

  .documents {
    padding: 96px 0;
    background: var(--ink);
    color: #eef6f2;
  }
  .documents .section-head p {
    color: #b7c8c1;
  }
  .doc-groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .doc-groups h3 {
    margin-bottom: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--lime);
    font-size: 1.15rem;
    color: #fff;
  }
  .doc-groups ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .doc-groups li {
    padding: 9px 0;
    border-top: 1px solid var(--forest-line);
    color: #c6d4ce;
  }

  .signers-section {
    padding: 96px 0;
  }
  .signers {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--ink);
  }
  .signers th,
  .signers td {
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .signers th {
    width: 32%;
    padding-right: 32px;
    font-size: 1.2rem;
    font-weight: 600;
  }
  .signers td {
    color: var(--ink-2);
  }

  .reasons {
    padding: 96px 0;
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .reasons h2 {
    max-width: 22ch;
    margin-bottom: 40px;
  }
  .reasons ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reasons li {
    padding-top: 14px;
    border-top: 2px solid var(--lime);
  }
  .reasons h3 {
    margin-bottom: 8px;
    font-size: 1.15rem;
  }
  .reasons p {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .also {
    padding: 96px 0;
  }
  .also-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .also-list li {
    padding-top: 12px;
    border-top: 1px solid var(--sage);
  }
  .also-list h3 {
    margin-bottom: 6px;
    font-size: 1.05rem;
  }
  .also-list p {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .access {
    padding: 96px 0;
    background: var(--ink);
    color: #eef6f2;
  }
  .access-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 64px;
  }
  .access h2 {
    color: #fff;
    margin-bottom: 16px;
  }
  .access-grid > div > p {
    max-width: 46ch;
    margin-bottom: 28px;
    color: #c6d4ce;
  }
  .access .ghost {
    color: #eef6f2;
    border-color: #5a7a6f;
  }
  .trust {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust li {
    padding-top: 12px;
    border-top: 1px solid var(--forest-line);
  }
  .trust h3 {
    margin-bottom: 4px;
    font-size: 1.05rem;
    color: #fff;
  }
  .trust p {
    color: #c6d4ce;
    font-size: 0.95rem;
  }

  .faq {
    padding: 96px 0;
  }
  .faq h2 {
    margin-bottom: 24px;
  }
  .faq-list {
    max-width: 800px;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex-shrink: 0;
    color: var(--ink-2);
  }
  details[open] summary::after {
    content: '–';
  }
  details p {
    max-width: 66ch;
    padding-bottom: 20px;
    color: var(--ink-2);
  }

  .foot {
    padding: 40px 0 72px;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 160px 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .foot-grid img {
    width: 130px;
    height: auto;
  }
  .fine {
    color: var(--ink-2);
