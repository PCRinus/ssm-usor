---
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<Default />

<!-- Starlight restores the sidebar's scroll only from the last page read in this tab, so an article
opened from the app would sit below the fold. Inline, it runs before the first paint. The app opens
every help link in the same tab, and a link to the article already open there only moves to the
heading without loading the page again. -->
<script is:inline aria-hidden="true">
  (() => {
    const reveal = () => {
      const scroller = document.getElementById('starlight__sidebar');
      const current = scroller?.querySelector('[aria-current="page"]');
      if (!scroller || !current) return;
      const pane = scroller.getBoundingClientRect();
      const link = current.getBoundingClientRect();
      if (!link.height || (link.top >= pane.top && link.bottom <= pane.bottom)) return;
      scroller.scrollTop += link.top - pane.top - (pane.height - link.height) / 2;
    };
    reveal();
    addEventListener('hashchange', reveal);
    window.navigation?.addEventListener('navigatesuccess', reveal);
  })();
</script>
