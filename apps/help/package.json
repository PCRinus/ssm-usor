{
  "name": "@ssm-usor/help",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build && pnpm check:build",
    "dev": "astro dev --port 4331",
    "stop": "astro dev stop && astro preview stop",
    "preview": "astro preview --port 4332",
    "typecheck": "astro check",
    "test": "vitest run",
    "generate:topics": "node --import tsx scripts/generate-topics.ts",
    "check:build": "node --import tsx scripts/check-build.ts",
    "check:sources": "node --import tsx scripts/check-sources.ts",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/starlight": "^0.42.6",
    "@ssm-usor/design-tokens": "workspace:*",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "github-slugger": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
