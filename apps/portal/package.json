{
  "name": "@ssm-usor/portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --port 5174",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "generate:routes": "tsr generate",
    "test:e2e": "playwright test",
    "test:e2e:flows": "playwright test --config playwright.flows.config.ts",
    "preview": "vite preview --port 4176",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "pnpm build && wrangler deploy",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript --strict"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@ssm-usor/api-http": "workspace:*",
    "@ssm-usor/contracts": "workspace:*",
    "@ssm-usor/ui": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "lucide-react": "^1.61.0",
    "posthog-js": "1.433.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@lingui/cli": "catalog:",
    "@lingui/format-po": "catalog:",
    "@lingui/vite-plugin": "catalog:",
    "@playwright/test": "^1.64.1",
    "@posthog/rollup-plugin": "1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "0.152.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
