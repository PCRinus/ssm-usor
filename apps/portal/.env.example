# Public browser configuration. Never use a Supabase secret/service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# The Turnstile widget's site key, which Supabase Auth's CAPTCHA needs. Development builds use
# Cloudflare's test key when it is unset, the pair of the local stack's test secret.
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# API origin; local development defaults to this value. Set the deployed API origin for production.
VITE_API_URL=http://localhost:8787

# Optional in local development. Use a separate EU PostHog project from production.
# When absent, analytics, replays, and error tracking stay off.
# VITE_POSTHOG_PROJECT_TOKEN=phc_replace_me
