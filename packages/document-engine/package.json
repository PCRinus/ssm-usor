{
  "name": "@ssm-usor/document-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./citations": {
      "types": "./dist/citation-index.d.ts",
      "import": "./dist/citation-index.js"
    },
    "./legal-quote": {
      "types": "./dist/legal-quote.d.ts",
      "import": "./dist/legal-quote.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "import": "./dist/signing.js"
    },
    "./ssm-duties": {
      "types": "./dist/ssm-duties.d.ts",
      "import": "./dist/ssm-duties.js"
    },
    "./template-files": {
      "types": "./dist/template-files.d.ts",
      "import": "./dist/template-files.js"
    },
    "./template-store": {
      "types": "./dist/template-store.d.ts",
      "import": "./dist/template-store.js"
    },
    "./token-diff": {
      "types": "./dist/token-diff.d.ts",
      "import": "./dist/token-diff.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "import-templates": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/import_templates.py",
    "preview": "tsx tools/preview.ts",
    "citations": "tsx tools/citations.ts",
    "validate-ooxml": "tsx tools/validate-ooxml.ts",
    "replace-quote": "tsx tools/replace-legal-quote.ts",
    "build-covers": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_covers.py",
    "build-contract": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_contract.py",
    "build-annex": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_annex.py",
    "build-signing": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_signing.py",
    "build-risk-zones": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_risk_zones.py",
    "build-ssm-duties": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_ssm_duties.py",
    "build-duties-acknowledgement": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_duties_acknowledgement.py",
    "build-sheets": "python3 tools/import/build_sheets.py",
    "build-tests": "python3 tools/import/build_tests.py",
    "build-test-sheet": "python3 tools/import/build_test_sheet.py"
  },
  "dependencies": {
    "@ssm-usor/contracts": "workspace:*",
    "docxtemplater": "3.69.3",
    "pizzip": "^3.3.0"
  },
  "devDependencies": {
    "@docx-editor.dev/core": "catalog:",
    "@docx-editor.dev/fonts": "catalog:",
    "@types/node": "^24.19.2",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
