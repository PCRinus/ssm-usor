{
  "name": "@ssm-usor/document-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./citations": {
      "types": "./dist/citation-index.d.ts",
      "import": "./dist/citation-index.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "import": "./dist/signing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "import-templates": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/import_templates.py",
    "preview": "tsx tools/preview.ts",
    "citations": "tsx tools/citations.ts",
    "build-covers": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_covers.py",
    "build-contract": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_contract.py",
    "build-annex-title": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_annex_title.py",
    "build-signing": "docker run --rm --entrypoint python3 -v \"$PWD:/work\" gotenberg/gotenberg:8 /work/tools/import/build_signing.py",
    "build-modules": "python3 tools/import/build_modules.py",
    "build-sheets": "python3 tools/import/build_sheets.py",
    "build-tests": "python3 tools/import/build_tests.py"
  },
  "dependencies": {
    "docxtemplater": "3.69.3",
    "pizzip": "^3.2.0"
  },
  "devDependencies": {
    "@docx-editor.dev/core": "catalog:",
    "@docx-editor.dev/fonts": "catalog:",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
