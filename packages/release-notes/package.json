{
  "name": "@ssm-usor/release-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "assemble": "node --import tsx scripts/assemble.ts",
    "publish-update": "node --import tsx scripts/publish-update.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
