{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "deploy:dry-run": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [".wrangler/deploy/**"]
    }
  }
}
