{
  "name": "ssm-usor",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm --silent dev:pdf || echo \"The PDF converter and signer did not start (is Docker running?). Documents and sheets have no PDF, and nothing can be signed, until pnpm dev:pdf succeeds.\"; pnpm --silent dev:stripe || echo \"The Stripe listener did not start. Payments made locally do not reach the API until pnpm dev:stripe succeeds.\"; turbo dev --concurrency=20",
    "dev:marketing": "pnpm --filter @ssm-usor/marketing dev",
    "stop:marketing": "pnpm --filter @ssm-usor/marketing stop",
    "dev:app": "pnpm --filter @ssm-usor/app dev",
    "dev:portal": "pnpm --filter @ssm-usor/portal dev",
    "dev:api": "pnpm --filter @ssm-usor/api dev",
    "dev:mail": "pnpm --filter @ssm-usor/mail dev",
    "dev:sms": "pnpm --filter @ssm-usor/sms dev",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:emails": "pnpm --filter @ssm-usor/mail email:dev",
    "dev:pdf": "docker compose up --detach --wait gotenberg signer",
    "dev:stripe": "pnpm --filter @ssm-usor/api dev:stripe",
    "stop:pdf": "docker compose down",
    "dev:extractor": "docker compose up --detach --wait extractor",
    "ui:add": "shadcn add --cwd apps/app",
    "preview:marketing": "pnpm --filter @ssm-usor/marketing preview:cloudflare",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "pnpm lint:eslint && pnpm lint:format",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:dry-run": "turbo deploy:dry-run",
    "deploy:marketing": "pnpm --filter @ssm-usor/marketing deploy",
    "deploy:app": "pnpm --filter @ssm-usor/app deploy",
    "deploy:portal": "pnpm --filter @ssm-usor/portal deploy",
    "deploy:api": "pnpm --filter @ssm-usor/api deploy",
    "deploy:mail": "pnpm --filter @ssm-usor/mail deploy",
    "deploy:sms": "pnpm --filter @ssm-usor/sms deploy",
    "deploy:pdf": "pnpm --filter @ssm-usor/pdf deploy",
    "deploy:legislation": "pnpm --filter @ssm-usor/legislation deploy",
    "prepare": "lefthook install",
    "generate:api": "pnpm --filter @ssm-usor/contracts --filter @ssm-usor/document-engine --filter @ssm-usor/import build && pnpm --filter @ssm-usor/api openapi:generate && orval --config orval.config.ts && prettier --write apps/api/openapi.json",
    "generate:help-topics": "pnpm --filter @ssm-usor/help generate:topics && prettier --write packages/help-topics/src/topics.ts",
    "generate:routes": "pnpm --filter @ssm-usor/app --filter @ssm-usor/portal generate:routes",
    "check:generated": "node scripts/check-generated.mjs",
    "seed": "pnpm --filter @ssm-usor/api seed",
    "seed:local": "pnpm --filter @ssm-usor/api seed:local",
    "templates:register": "pnpm --filter @ssm-usor/api templates:register",
    "templates:register:local": "pnpm --filter @ssm-usor/api templates:register:local",
    "legislation:check": "pnpm --filter @ssm-usor/api legislation:check",
    "legislation:check:local": "pnpm --filter @ssm-usor/api legislation:check:local",
    "legislation:cron": "pnpm --filter @ssm-usor/legislation start",
    "generate:db": "supabase gen types typescript --local --schema public > apps/api/src/database.types.ts && prettier --write apps/api/src/database.types.ts",
    "supabase:test": "supabase test db",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "orval": "^8.44.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "shadcn": "^4.22.1",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.72.0"
  }
}
