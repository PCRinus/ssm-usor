{
  "name": "ssm-usor",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:marketing": "pnpm --filter @ssm-usor/marketing dev",
    "dev:dashboard": "pnpm --filter @ssm-usor/dashboard dev",
    "dev:api": "pnpm --filter @ssm-usor/api dev",
    "typecheck": "turbo typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "deploy:dry-run": "turbo deploy:dry-run",
    "deploy:marketing": "pnpm --filter @ssm-usor/marketing deploy",
    "deploy:dashboard": "pnpm --filter @ssm-usor/dashboard deploy",
    "deploy:api": "pnpm --filter @ssm-usor/api deploy"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.10.12"
  }
}
